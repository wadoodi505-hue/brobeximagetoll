export type IncreaseImageFormat = "image/jpeg" | "image/png" | "image/webp";

export type IncreaseImageOptions = {
  format: IncreaseImageFormat;
  quality: number;
  targetBytes: number;
  scale: number;
  preserveDimensions: boolean;
  maxPixels?: number;
};

export type IncreaseImageResult = {
  blob: Blob;
  width: number;
  height: number;
  quality: number;
  reachedTarget: boolean;
  message: string;
};

const DEFAULT_MAX_PIXELS = 30_000_000;

function canvasToBlob(
  canvas: HTMLCanvasElement,
  type: IncreaseImageFormat,
  quality: number,
): Promise<Blob> {
  return new Promise((resolve, reject) => {
    canvas.toBlob(
      (blob) => {
        if (blob) resolve(blob);
        else reject(new Error("Your browser could not encode this image. Try another format."));
      },
      type,
      type === "image/png" ? undefined : quality,
    );
  });
}

async function loadImage(file: File): Promise<HTMLImageElement> {
  const url = URL.createObjectURL(file);
  try {
    const image = new Image();
    image.decoding = "async";
    image.src = url;
    await image.decode();
    return image;
  } finally {
    // The image has decoded; its pixels remain available after the URL is revoked.
    URL.revokeObjectURL(url);
  }
}

function drawImage(
  image: HTMLImageElement,
  width: number,
  height: number,
  format: IncreaseImageFormat,
): HTMLCanvasElement {
  const canvas = document.createElement("canvas");
  canvas.width = width;
  canvas.height = height;
  const context = canvas.getContext("2d", { alpha: format !== "image/jpeg" });
  if (!context) throw new Error("Canvas is unavailable in this browser.");
  // JPEG cannot store transparency, so composite transparent pixels onto white.
  if (format === "image/jpeg") {
    context.fillStyle = "#ffffff";
    context.fillRect(0, 0, width, height);
  }
  context.imageSmoothingEnabled = true;
  context.imageSmoothingQuality = "high";
  context.drawImage(image, 0, 0, width, height);
  return canvas;
}

export async function increaseImageFileSize(
  file: File,
  options: IncreaseImageOptions,
): Promise<IncreaseImageResult> {
  if (!file.type.startsWith("image/")) {
    throw new Error("Please select a valid image file.");
  }
  if (file.size > 25 * 1024 * 1024) {
    throw new Error("This tool supports images up to 25 MB.");
  }

  const image = await loadImage(file);
  const sourceWidth = image.naturalWidth;
  const sourceHeight = image.naturalHeight;
  if (!sourceWidth || !sourceHeight) throw new Error("The selected image has invalid dimensions.");

  const maxPixels = options.maxPixels ?? DEFAULT_MAX_PIXELS;
  const targetBytes = Math.max(1, Math.round(options.targetBytes));
  const requestedScale = options.preserveDimensions ? 1 : Math.max(1, Math.min(4, options.scale));
  const scaleLimit = Math.min(
    requestedScale,
    Math.sqrt(maxPixels / (sourceWidth * sourceHeight)),
  );
  if (scaleLimit < 1) {
    throw new Error("This image is too large for the browser processing limit. Try a smaller source image.");
  }

  const renderAt = async (scale: number, quality: number) => {
    const width = Math.max(1, Math.round(sourceWidth * scale));
    const height = Math.max(1, Math.round(sourceHeight * scale));
    const canvas = drawImage(image, width, height, options.format);
    const blob = await canvasToBlob(canvas, options.format, quality);
    return { blob, width, height };
  };

  const initialScale = Math.max(1, scaleLimit);
  const initial = await renderAt(initialScale, options.quality);
  if (initial.blob.size >= targetBytes) {
    // If it already exceeds the requested minimum, reduce dimensions only when
    // the user explicitly selected preservation-off; never silently shrink below 1Ã—.
    return {
      ...initial,
      quality: options.quality,
      reachedTarget: true,
      message: "The generated image meets or exceeds your requested minimum size.",
    };
  }

  // JPEG/WebP quality search: use the highest quality first, then test whether
  // the requested minimum can be reached without changing the selected dimensions.
  if (options.format !== "image/png") {
    const highest = await renderAt(initialScale, 1);
    if (highest.blob.size >= targetBytes) {
      let low = options.quality;
      let high = 1;
      let best = highest;
      let bestQuality = 1;
      for (let i = 0; i < 8; i += 1) {
        const mid = (low + high) / 2;
        const candidate = await renderAt(initialScale, mid);
        if (candidate.blob.size >= targetBytes) {
          best = candidate;
          bestQuality = mid;
          high = mid;
        } else {
          low = mid;
        }
      }
      return {
        ...best,
        quality: bestQuality,
        reachedTarget: true,
        message: "The requested minimum size was reached by adjusting encoding quality.",
      };
    }
  }

  // If quality alone cannot reach the target, increase pixel dimensions gradually.
  // Binary search finds the smallest scale that reaches the requested byte count.
  if (scaleLimit > 1 && !options.preserveDimensions) {
    let low = 1;
    let high = scaleLimit;
    let best = initial;
    let bestScale = scaleLimit;
    const highResult = await renderAt(high, options.format === "image/png" ? 1 : 1);
    if (highResult.blob.size >= targetBytes) {
      best = highResult;
      for (let i = 0; i < 9; i += 1) {
        const mid = (low + high) / 2;
        const candidate = await renderAt(mid, 1);
        if (candidate.blob.size >= targetBytes) {
          best = candidate;
          bestScale = mid;
          high = mid;
        } else {
          low = mid;
        }
      }
      return {
        ...best,
        quality: 1,
        reachedTarget: true,
        message: "The requested minimum size was reached by increasing pixel dimensions.",
      };
    }
  }

  return {
    ...initial,
    quality: options.quality,
    reachedTarget: false,
    message:
      "The browser reached its practical output limit before the requested size. Choose a larger scale, a less compressible format, or a lower target.",
  };
}

