"use client";
import { useEffect, useMemo, useState } from "react";
import { UploadCloud, Download, RotateCcw, ShieldCheck, Image as ImageIcon, AlertCircle, CheckCircle2 } from "lucide-react";
import type { ToolDefinition } from "@/types/tools";
import { formatBytes, processImage, processImages } from "@/lib/image/process";
const MAX_BYTES=20*1024*1024;
export function ImageWorkspace({tool}:{tool:ToolDefinition}) {
 const [file,setFile]=useState<File|null>(null);const [files,setFiles]=useState<File[]>([]);const [preview,setPreview]=useState("");const [result,setResult]=useState("");const [resultBlob,setResultBlob]=useState<Blob|null>(null);const [busy,setBusy]=useState(false);const [error,setError]=useState("");const [message,setMessage]=useState("");
 const [width,setWidth]=useState(800);const [height,setHeight]=useState(600);const [lock,setLock]=useState(true);const [quality,setQuality]=useState(82);const [format,setFormat]=useState(tool.outputMime || "image/webp");const [cropX,setCropX]=useState(0);const [cropY,setCropY]=useState(0);const [cropW,setCropW]=useState(800);const [cropH,setCropH]=useState(600);const [flipX,setFlipX]=useState(true);const [flipY,setFlipY]=useState(false);const [text,setText]=useState("BROBEX");const [textSize,setTextSize]=useState(36);const [textColor,setTextColor]=useState("#ffffff");const [borderWidth,setBorderWidth]=useState(12);const [borderColor,setBorderColor]=useState("#171717");const [pixelSize,setPixelSize]=useState(12);const [rotation,setRotation]=useState(90);const [blurAmount,setBlurAmount]=useState(4);const [metadata,setMetadata]=useState<{width:number;height:number;type:string;size:number}|null>(null);
 const op=tool.operation; const canProcess=tool.status==="browser"&&!!op;
 useEffect(()=>()=>{if(preview)URL.revokeObjectURL(preview)},[preview]);
 useEffect(()=>()=>{if(result)URL.revokeObjectURL(result)},[result]);
 const reset=()=>{setFiles([]);setFile(null);setPreview("");setResult("");setResultBlob(null);setError("");setMessage("");setMetadata(null)};
 function selectFile(next:File|null){setFiles(next?[next]:[]);setError("");setMessage("");setResult("");setResultBlob(null);setMetadata(null);if(!next)return;if(!next.size){setError("This file is empty.");return}if(next.size>MAX_BYTES){setError("Maximum file size is 20 MB for this browser workspace.");return}if(!next.type.startsWith("image/")){setError("Choose a supported image file.");return}if(preview)URL.revokeObjectURL(preview);setFile(next);setPreview(URL.createObjectURL(next));const url=URL.createObjectURL(next);const img=new Image();img.onload=()=>{setWidth(img.naturalWidth);setHeight(img.naturalHeight);setCropW(img.naturalWidth);setCropH(img.naturalHeight);URL.revokeObjectURL(url)};img.onerror=()=>{URL.revokeObjectURL(url);setError("The browser could not decode this image. It may use an unsupported codec.")};img.src=url;}
 async function run(){if(!file)return;setBusy(true);setError("");setMessage("");try{if(op==="combine"){if(files.length<2)throw new Error("Choose at least two images to combine.");const output=await processImages(files,tool.slug==="collage-maker"?"vertical":"horizontal");const url=URL.createObjectURL(output.blob);setResult(url);setResultBlob(output.blob);setMessage(`Combined ${files.length} images into ${output.width} Ã— ${output.height} pixels.`);return}if(op==="metadata"){const img=new Image();img.src=preview;await img.decode();setMetadata({width:img.naturalWidth,height:img.naturalHeight,type:file.type||"Unknown",size:file.size});setMessage("Metadata read from the selected file and browser decoder.");return}if(!canProcess)throw new Error("This tool needs an external provider or specialist codec. No provider is configured, so no result can be generated.");if(!op)throw new Error("No image operation is configured.");const settings:Parameters<typeof processImage>[1]={operation:op,width,height,quality:quality/100,format,cropX,cropY,cropWidth:cropW,cropHeight:cropH,flipX,flipY,text,textSize,textColor,borderWidth,borderColor,pixelSize,rotation,blurAmount};const output=await processImage(file,settings);const url=URL.createObjectURL(output.blob);setResult(url);setResultBlob(output.blob);setMessage(`Processed ${output.width} Ã— ${output.height} pixels. Output: ${formatBytes(output.blob.size)}.`)}catch(e){setError(e instanceof Error?e.message:"Processing failed. Try a different image or setting.")}finally{setBusy(false)}}
 const outputName=useMemo(()=>`${file?.name.replace(/\.[^.]+$/,"")||"brobex-image"}.${(resultBlob?.type||format)==="image/jpeg"?"jpg":(resultBlob?.type||format).split("/")[1]||"png"}`,[file,resultBlob,format]);
 return <div className="workspace"><div className="workspace-top"><div><span className="eyebrow">BROWSER WORKSPACE</span><h2>Upload and process</h2><p>Your image stays in this browser for the supported operations below.</p></div><span className="privacy-chip"><ShieldCheck size={15}/> </span></div>
 <label className={`dropzone ${file?"has-file":""}`} onDragOver={e=>e.preventDefault()} onDrop={e=>{e.preventDefault();selectFile(e.dataTransfer.files?.[0]||null)}}><input type="file" multiple={op==="combine"} accept={tool.acceptedTypes.join(",")} onChange={e=>{if(op==="combine"){const chosen=Array.from(e.target.files||[]);setFiles(chosen);setFile(chosen[0]||null);setError("");setMessage("");setResult("");setResultBlob(null);if(preview)URL.revokeObjectURL(preview);const nextPreview=chosen[0]?URL.createObjectURL(chosen[0]):"";setPreview(nextPreview);if(chosen.some(f=>!f.type.startsWith("image/")||f.size>MAX_BYTES))setError("Choose image files no larger than 20 MB each.");}else selectFile(e.target.files?.[0]||null)}}/>{file?<><ImageIcon size={28}/><strong>{op==="combine"?`${files.length} images selected`:file.name}</strong><span>{op==="combine"?files.map(f=>f.name).join(" Â· "):`${formatBytes(file.size)} Â· ${file.type||"Unknown MIME type"}`}</span><small>Choose another file by clicking here</small></>:<><UploadCloud size={30}/><strong>Drop an image here or browse files</strong><span>Image formats supported by your browser Â· 20 MB maximum</span><small>For privacy, no file is uploaded by this workspace.</small></>}</label>
 {file&&<div className="file-facts"><span>Original: <b>{file.name}</b></span><span>Size: <b>{formatBytes(file.size)}</b></span><span>Type: <b>{file.type||"Unknown"}</b></span></div>}
 {file&&<div className="workspace-columns"><div className="preview-panel"><div className="panel-heading">Original preview</div><div className="preview-canvas"><img src={preview} alt="Selected original image preview"/></div>{result&&<><div className="panel-heading">Processed result</div><div className="preview-canvas"><img src={result} alt="Processed image preview"/></div></>}</div><div className="settings-panel"><h3>Settings</h3>
 {op==="resize"&&<><label>Width (px)<input type="number" min="1" max="12000" value={width} onChange={e=>{const v=Number(e.target.value);setWidth(v);if(lock&&file){const ratio=height/Math.max(1,width);setHeight(Math.max(1,Math.round(v*ratio)))}}}/></label><label>Height (px)<input type="number" min="1" max="12000" value={height} onChange={e=>setHeight(Number(e.target.value))}/></label><label className="check-setting"><input type="checkbox" checked={lock} onChange={e=>setLock(e.target.checked)}/> Keep proportions (width updates height)</label></>}
 {op==="compress"&&<><label>Output format<select value={format} onChange={e=>setFormat(e.target.value)}><option value="image/webp">WebP</option><option value="image/jpeg">JPEG</option><option value="image/png">PNG (lossless)</option></select></label><label>Quality: {quality}%<input type="range" min="10" max="100" value={quality} onChange={e=>setQuality(Number(e.target.value))}/></label></>}
 {op==="convert"&&<label>Output format<select value={format} onChange={e=>setFormat(e.target.value)}><option value={tool.outputMime||"image/png"}>{tool.outputMime||"image/png"}</option><option value="image/png">PNG</option><option value="image/jpeg">JPEG</option><option value="image/webp">WebP</option></select></label>}
 {op==="crop"&&<div className="settings-grid">{([["X",cropX,setCropX],["Y",cropY,setCropY],["Width",cropW,setCropW],["Height",cropH,setCropH]] as [string, number, (value: number) => void][]).map(([label,value,setter])=><label key={label}>{label}<input type="number" min="0" value={value} onChange={e=>setter(Number(e.target.value))}/></label>)}</div>}
 {op==="flip"&&<><label className="check-setting"><input type="checkbox" checked={flipX} onChange={e=>setFlipX(e.target.checked)}/> Flip horizontally</label><label className="check-setting"><input type="checkbox" checked={flipY} onChange={e=>setFlipY(e.target.checked)}/> Flip vertically</label></>}
 {op==="rotate"&&<label>Rotation<select value={rotation} onChange={e=>setRotation(Number(e.target.value))}><option value={90}>90Â° clockwise</option><option value={180}>180Â°</option><option value={270}>270Â° clockwise</option></select></label>}
 {op==="pixelate"&&<label>Pixel block size<input type="range" min="2" max="80" value={pixelSize} onChange={e=>setPixelSize(Number(e.target.value))}/><span>{pixelSize}px</span></label>}
 {op==="text"&&<><label>Overlay text<input value={text} onChange={e=>setText(e.target.value)} maxLength={120}/></label><label>Text size<input type="number" min="8" max="240" value={textSize} onChange={e=>setTextSize(Number(e.target.value))}/></label><label>Text color<input type="color" value={textColor} onChange={e=>setTextColor(e.target.value)}/></label></>}
 {op==="border"&&<><label>Border width<input type="number" min="1" max="200" value={borderWidth} onChange={e=>setBorderWidth(Number(e.target.value))}/></label><label>Border color<input type="color" value={borderColor} onChange={e=>setBorderColor(e.target.value)}/></label></>}
 {op==="blur"&&<label>Blur amount<input type="range" min="1" max="30" value={blurAmount} onChange={e=>setBlurAmount(Number(e.target.value))}/></label>}
 {op==="metadata"&&<p className="hint">Displays dimensions, MIME type, and file size. Full EXIF metadata is not available through every browser.</p>}
 {!op&&<p className="hint">This tool requires an integration that is not configured.</p>}
 <div className="workspace-actions"><button className="button button-dark" onClick={run} disabled={busy||!file||(op==="combine"&&files.length<2)}>{busy?"Processingâ€¦":op==="metadata"?"Read metadata":op==="combine"?"Combine images":"Process image"}</button><button className="button button-light" onClick={reset}><RotateCcw size={15}/> Reset</button></div>
 {resultBlob&&<a className="button button-dark download-button" href={result} download={outputName}><Download size={16}/> Download {outputName}</a>}
 {message&&<p className="notice success"><CheckCircle2 size={16}/>{message}</p>}{error&&<p className="notice error"><AlertCircle size={16}/>{error}</p>}
 {metadata&&<div className="metadata-card"><h4>Readable image properties</h4><p>Dimensions: {metadata.width} Ã— {metadata.height}px</p><p>MIME type: {metadata.type}</p><p>File size: {formatBytes(metadata.size)}</p></div>}
 </div></div>}
 {tool.status==="integration"&&<div className="integration-notice"><span className="integration-icon"><WandIcon/></span><div><h3>Integration required</h3><p>This tool is listed in the BROBEX catalog, but its required provider or codec is not configured in this starter. It will not pretend to process your file or offer a fake download.</p><p className="hint">Required path: <code>{tool.method}</code>. Configure a secure server-side adapter and validate uploads before enabling this operation.</p></div></div>}
 </div>
}
function WandIcon(){return <span aria-hidden="true">âœ³</span>}


