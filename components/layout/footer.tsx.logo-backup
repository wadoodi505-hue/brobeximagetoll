import Link from "next/link";
import { categories } from "@/lib/tools";
export function Footer(){return <footer className="footer"><div className="footer-main"><div className="footer-brand"><Link className="brand" href="/"><span className="brand-mark">B</span><span>BROBEX<span className="brand-light">TOOLS</span></span></Link><p>Thoughtful, practical tools for everyday creative work.</p><a href="https://brobexportfolio.vercel.app/" target="_blank" rel="noopener noreferrer">Built by BROBEX ↗</a></div><div className="footer-links"><span className="eyebrow">TOOLS</span>{categories.map(c=><Link key={c.id} href={c.href}>{c.label} tools</Link>)}</div><div className="footer-links"><span className="eyebrow">COMPANY</span><Link href="/about">About</Link><Link href="/contact">Contact</Link><Link href="/privacy">Privacy</Link><Link href="/terms">Terms</Link></div></div><div className="footer-bottom"><span>© {new Date().getFullYear()} BROBEX. All rights reserved.</span><span>Useful by design. Built with care.</span></div></footer>}
