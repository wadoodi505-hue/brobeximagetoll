@tailwind base;
@tailwind components;
@tailwind utilities;
.crop-preview-stage {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    min-height: 220px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--bg);
}

.crop-preview-stage img {
    display: block;
    max-width: 100%;
    max-height: 480px;
    width: auto;
    height: auto;
    object-fit: contain;
}

.crop-preview-toggle {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 12px;
    font-size: 14px;
    cursor: pointer;
}

.crop-controls-heading {
    display: flex;
    flex-direction: column;
    gap: 4px;
    grid-column: 1 / -1;
}

.crop-controls-heading span {
    color: var(--muted, #888);
    font-size: 13px;
}

.crop-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    grid-column: 1 / -1;
}
:root {
    color-scheme: light;
    --bg: #F7F7F5;
    --surface: #fff;
    --ink: #171717;
    --muted: #737373;
    --line: #E5E5E5;
    --soft: #F0F0EE;
    --dark: #111;
    --shadow: 0 8px 30px rgba(0, 0, 0, .04)
}

:root[data-theme="dark"] {
    color-scheme: dark;
    --bg: #111;
    --surface: #191919;
    --ink: #f5f5f5;
    --muted: #a3a3a3;
    --line: #303030;
    --soft: #242424;
    --dark: #f5f5f5;
    --shadow: 0 8px 30px rgba(0, 0, 0, .2)
}

* {
    box-sizing: border-box
}

html {
    scroll-behavior: smooth;
    scroll-padding-top: 90px
}

body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: Arial, Helvetica, sans-serif;
    font-size: 15px;
    line-height: 1.55;
    transition: background .2s, color .2s
}

a {
    color: inherit;
    text-decoration: none
}

button,
input,
select,
textarea {
    font: inherit
}

button,
a,
input,
select {
    outline-offset: 3px
}

button:focus-visible,
a:focus-visible,
input:focus-visible,
select:focus-visible {
    outline: 2px solid var(--ink)
}

button {
    cursor: pointer
}

button:disabled {
    opacity: .55;
    cursor: not-allowed
}

.site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    width: 100%;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line)
}

.nav-inner {
    max-width: 1240px;
    height: 72px;
    margin: auto;
    padding: 0 28px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px
}

.brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
    font-weight: 800;
    letter-spacing: .12em;
    white-space: nowrap;
    width: max-content
}

.brand-mark {
    width: 32px;
    height: 32px;
    border-radius: 9px;
    background: var(--ink);
    color: var(--bg);
    display: grid;
    place-items: center;
    font-size: 19px;
    letter-spacing: -.05em
}

.brand-light {
    font-weight: 500;
    color: var(--muted);
    margin-left: 5px;
    font-size: 11px
}

.desktop-nav {
    display: flex;
    gap: 7px;
    align-items: center
}

.desktop-nav a {
    padding: 9px 13px;
    color: var(--muted);
    border-radius: 8px;
    font-size: 13px
}

.desktop-nav a:hover,
.desktop-nav a:focus-visible {
    background: var(--soft);
    color: var(--ink)
}

.nav-actions {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 14px
}

.portfolio-link {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 13px;
    font-weight: 600
}

.icon-button,
.mobile-menu-button {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink);
    border-radius: 10px
}

.mobile-menu-button {
    display: none
}

.mobile-nav {
    display: none
}

.container {
    width: min(1160px, calc(100% - 48px));
    margin-inline: auto
}

.hero {
    padding: 86px 0 60px;
    text-align: center;
    max-width: 900px;
    margin: auto
}

.eyebrow {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: .15em;
    color: var(--muted);
    font-weight: 700
}

.hero h1 {
    font-size: clamp(44px, 7vw, 76px);
    line-height: 1.04;
    letter-spacing: -.065em;
    margin: 17px 0 14px;
    font-weight: 750
}

.hero-subtitle {
    font-size: 16px;
    font-weight: 600;
    margin: 0 0 10px
}

.hero-description {
    max-width: 650px;
    margin: 0 auto;
    color: var(--muted);
    font-size: 16px
}

.hero-search {
    max-width: 690px;
    margin: 34px auto 18px;
    text-align: left
}

.search-box {
    display: flex;
    align-items: center;
    gap: 12px;
    border: 1px solid var(--line);
    background: var(--surface);
    padding: 0 15px;
    height: 58px;
    border-radius: 14px;
    box-shadow: var(--shadow);
    color: var(--muted)
}

.search-box input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--ink);
    height: 100%
}

.search-box kbd {
    border: 1px solid var(--line);
    border-radius: 5px;
    padding: 1px 7px;
    font-size: 11px;
    color: var(--muted)
}

.search-box button {
    display: grid;
    place-items: center;
    border: 0;
    background: transparent;
    color: var(--muted)
}

.feature-pills {
    display: flex;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 22px
}

.feature-pills span,
.privacy-chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    border: 1px solid var(--line);
    padding: 7px 10px;
    border-radius: 999px;
    color: var(--muted);
    font-size: 12px
}

.section {
    padding: 36px 0 74px
}

.section-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 20px;
    margin-bottom: 24px
}

.section-heading h2,
.page-title h1 {
    font-size: clamp(30px, 4vw, 42px);
    line-height: 1.12;
    letter-spacing: -.045em;
    margin: 7px 0 9px
}

.section-heading p,
.page-title p {
    color: var(--muted);
    margin: 0;
    max-width: 660px
}

.text-link {
    font-size: 13px;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 4px
}

.category-strip {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 12px;
    margin: 25px 0 55px
}

.category-tile {
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--surface);
    transition: transform .16s, border-color .16s
}

.category-tile:hover {
    transform: translateY(-2px);
    border-color: var(--muted)
}

.category-tile strong {
    display: block;
    margin: 13px 0 4px
}

.category-tile p {
    font-size: 12px;
    color: var(--muted);
    margin: 0
}

.tile-icon,
.tool-icon {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: var(--soft);
    color: var(--ink)
}

.search-section {
    width: 100%
}

.search-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin: 14px 0 18px;
    font-size: 12px;
    color: var(--muted)
}

.filter-label {
    display: flex;
    align-items: center;
    gap: 6px
}

.filter-label select {
    background: var(--surface);
    border: 1px solid var(--line);
    color: var(--ink);
    border-radius: 8px;
    padding: 6px
}

.tool-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px
}

.tool-card {
    position: relative;
    display: flex;
    gap: 13px;
    align-items: flex-start;
    padding: 17px;
    border: 1px solid var(--line);
    background: var(--surface);
    border-radius: 13px;
    min-height: 145px;
    transition: border-color .16s, transform .16s, background .16s
}

.tool-card:hover {
    border-color: #aaa;
    transform: translateY(-2px)
}

.tool-icon {
    width: 38px;
    height: 38px;
    flex: 0 0 auto
}

.tool-card-copy {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-right: 8px
}

.tool-name {
    font-weight: 700;
    font-size: 14px;
    line-height: 1.35
}

.tool-description {
    font-size: 12px;
    color: var(--muted);
    line-height: 1.5
}

.status {
    font-size: 10px;
    width: max-content;
    border-radius: 4px;
    padding: 3px 6px;
    margin-top: 3px;
    font-weight: 700
}

.status.browser {
    background: #e8eee8;
    color: #31543b
}

.status.integration {
    background: var(--soft);
    color: var(--muted)
}

.card-arrow {
    position: absolute;
    right: 14px;
    top: 15px;
    color: var(--muted)
}

.empty-state {
    padding: 60px 20px;
    text-align: center;
    border: 1px dashed var(--line);
    border-radius: 16px;
    color: var(--muted)
}

.empty-state h3 {
    color: var(--ink);
    margin-bottom: 4px
}

.button {
    min-height: 42px;
    border-radius: 9px;
    display: inline-flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    padding: 10px 15px;
    font-weight: 700;
    font-size: 13px;
    border: 1px solid transparent
}

.button-dark {
    background: var(--ink);
    color: var(--bg)
}

.button-dark:hover {
    opacity: .85
}

.button-light {
    background: var(--surface);
    color: var(--ink);
    border-color: var(--line)
}

.page-title {
    padding: 64px 0 30px
}

.breadcrumb {
    font-size: 12px;
    color: var(--muted);
    margin-bottom: 20px
}

.breadcrumb a {
    text-decoration: underline;
    text-underline-offset: 3px
}

.page-content {
    max-width: 850px;
    padding-bottom: 80px
}

.page-content h2 {
    font-size: 23px;
    letter-spacing: -.03em;
    margin-top: 30px
}

.page-content p,
.page-content li {
    color: var(--muted)
}

.tool-detail-title {
    display: flex;
    gap: 15px;
    align-items: flex-start
}

.tool-detail-title .tool-icon {
    width: 48px;
    height: 48px
}

.tool-detail-title h1 {
    margin: 0;
    font-size: clamp(30px, 4vw, 44px);
    letter-spacing: -.05em
}

.tool-detail-title p {
    margin: 8px 0;
    color: var(--muted)
}

.workspace {
    margin: 28px 0 75px;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: var(--surface);
    padding: 24px
}

.workspace-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 15px;
    margin-bottom: 22px
}

.workspace-top h2 {
    font-size: 22px;
    letter-spacing: -.03em;
    margin: 5px 0
}

.workspace-top p {
    font-size: 13px;
    color: var(--muted);
    margin: 0
}

.dropzone {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 9px;
    padding: 30px 18px;
    min-height: 180px;
    border: 1px dashed #b8b8b5;
    border-radius: 14px;
    background: var(--bg);
    text-align: center;
    cursor: pointer;
    color: var(--muted)
}

.dropzone input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer
}

.dropzone strong {
    color: var(--ink);
    font-size: 14px
}

.dropzone span,
.dropzone small {
    font-size: 12px
}

.dropzone.has-file {
    min-height: 130px
}

.file-facts {
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
    padding: 14px 0;
    font-size: 12px;
    color: var(--muted)
}

.file-facts b {
    color: var(--ink);
    font-weight: 600
}

.workspace-columns {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(280px, .8fr);
    gap: 20px;
    margin-top: 20px
}

.preview-panel,
.settings-panel {
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 14px;
    min-width: 0
}

.panel-heading {
    font-size: 12px;
    font-weight: 700;
    margin: 2px 0 12px
}

.preview-canvas {
    display: grid;
    place-items: center;
    min-height: 170px;
    max-height: 420px;
    overflow: hidden;
    background: repeating-conic-gradient(var(--soft) 0% 25%, var(--surface) 0% 50%) 50% / 18px 18px;
    border-radius: 8px;
    margin-bottom: 18px
}

.preview-canvas img {
    display: block;
    max-width: 100%;
    max-height: 400px;
    object-fit: contain
}

.settings-panel h3 {
    font-size: 16px;
    margin: 2px 0 16px
}

.settings-panel>label,
.settings-grid label {
    display: flex;
    flex-direction: column;
    gap: 7px;
    font-size: 12px;
    font-weight: 600;
    margin: 13px 0
}

.settings-panel input:not([type=checkbox]):not([type=range]):not([type=color]),
.settings-panel select {
    width: 100%;
    min-height: 38px;
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 8px;
    background: var(--bg);
    color: var(--ink)
}

.settings-panel input[type=range] {
    width: 100%;
    accent-color: var(--ink)
}

.settings-panel input[type=color] {
    width: 100%;
    height: 38px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface)
}

.check-setting {
    display: flex !important;
    flex-direction: row !important;
    align-items: center;
    gap: 9px !important
}

.settings-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px
}

.settings-grid label {
    min-width: 0
}

.workspace-actions {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 20px
}

.download-button {
    margin-top: 10px;
    width: 100%
}

.notice {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 12px;
    padding: 11px;
    border-radius: 8px;
    margin-top: 14px
}

.notice.success {
    background: #e8eee8;
    color: #31543b
}

.notice.error {
    background: #f8e9e7;
    color: #8d3028
}

.hint {
    font-size: 12px;
    color: var(--muted);
    line-height: 1.6
}

.metadata-card {
    padding: 13px;
    background: var(--bg);
    border-radius: 9px;
    font-size: 12px;
    margin-top: 14px
}

.metadata-card h4 {
    margin: 0 0 8px
}

.metadata-card p {
    margin: 4px 0;
    color: var(--muted)
}

.integration-notice {
    display: flex;
    gap: 15px;
    border: 1px solid var(--line);
    border-radius: 13px;
    padding: 20px;
    margin-top: 20px;
    background: var(--bg)
}

.integration-icon {
    display: grid;
    place-items: center;
    flex: 0 0 40px;
    height: 40px;
    border-radius: 10px;
    background: var(--soft);
    font-size: 20px
}

.integration-notice h3 {
    margin: 0 0 7px;
    font-size: 16px
}

.integration-notice p {
    margin: 0 0 8px;
    color: var(--muted);
    font-size: 13px
}

.integration-notice code {
    overflow-wrap: anywhere
}

.privacy-line {
    display: flex;
    align-items: center;
    gap: 7px;
    color: var(--muted);
    font-size: 12px;
    margin-top: 20px
}

.footer {
    border-top: 1px solid var(--line);
    padding: 45px 24px 20px;
    background: var(--surface)
}

.footer-main {
    max-width: 1160px;
    margin: auto;
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 40px;
    padding-bottom: 35px
}

.footer-brand p {
    max-width: 270px;
    color: var(--muted);
    font-size: 13px
}

.footer-brand>a:last-child {
    font-size: 12px;
    text-decoration: underline;
    text-underline-offset: 4px
}

.footer-links {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    font-size: 13px
}

.footer-links a {
    color: var(--muted)
}

.footer-links a:hover {
    color: var(--ink)
}

.footer-bottom {
    max-width: 1160px;
    margin: auto;
    padding-top: 17px;
    border-top: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    gap: 20px;
    color: var(--muted);
    font-size: 11px
}

.not-found {
    padding: 100px 0;
    text-align: center
}

.not-found h1 {
    font-size: 42px;
    letter-spacing: -.05em
}

.not-found p {
    color: var(--muted)
}

.divider {
    height: 1px;
    background: var(--line);
    margin: 35px 0
}

@media(max-width:900px) {
    .nav-inner {
        grid-template-columns: 1fr auto 1fr;
        padding: 0 20px;
        gap: 10px
    }

    .desktop-nav {
        gap: 0
    }

    .desktop-nav a {
        padding: 9px 8px
    }

    .portfolio-link {
        font-size: 0
    }

    .portfolio-link svg {
        width: 18px;
        height: 18px
    }

    .tool-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr))
    }

    .category-strip {
        grid-template-columns: repeat(3, minmax(0, 1fr))
    }

    .workspace-columns {
        grid-template-columns: 1fr
    }

    .preview-panel {
        order: 0
    }

    .settings-panel {
        order: 1
    }
}

@media(max-width:640px) {
    .nav-inner {
        height: 64px;
        grid-template-columns: 1fr auto 1fr;
        gap: 0;
        padding: 0 16px
    }

    .brand {
        font-size: 13px;
        gap: 7px
    }

    .brand-mark {
        width: 29px;
        height: 29px
    }

    .brand-light {
        font-size: 9px
    }

    .desktop-nav {
        display: none
    }

    .mobile-menu-button {
        display: grid;
        grid-column: 2;
        grid-row: 1;
        width: 38px;
        height: 38px
    }

    .nav-actions {
        grid-column: 3;
        grid-row: 1;
        gap: 0
    }

    .portfolio-link {
        display: none
    }

    .mobile-nav {
        display: flex;
        position: absolute;
        top: calc(100% + 1px);
        left: 0;
        right: 0;
        flex-direction: column;
        gap: 0;
        padding: 8px 16px 16px;
        background: var(--bg);
        border-bottom: 1px solid var(--line);
        box-shadow: var(--shadow);
        opacity: 0;
        visibility: hidden;
        transform: translateY(-6px);
        transition: opacity .16s, transform .16s, visibility .16s
    }

    .mobile-nav.is-open {
        opacity: 1;
        visibility: visible;
        transform: translateY(0)
    }

    .mobile-nav a {
        display: flex;
        justify-content: space-between;
        padding: 14px 8px;
        border-bottom: 1px solid var(--line);
        font-weight: 600
    }

    .mobile-nav a:last-child {
        border-bottom: 0
    }

    .container {
        width: calc(100% - 32px)
    }

    .hero {
        padding: 60px 0 35px
    }

    .hero h1 {
        font-size: clamp(42px, 13vw, 62px)
    }

    .hero-description {
        font-size: 14px
    }

    .hero-search {
        margin-top: 25px
    }

    .search-box {
        height: 54px
    }

    .search-box kbd {
        display: none
    }

    .feature-pills {
        gap: 7px
    }

    .feature-pills span {
        font-size: 10px
    }

    .section {
        padding: 25px 0 55px
    }

    .section-heading {
        align-items: flex-start;
        flex-direction: column
    }

    .section-heading h2 {
        font-size: 31px
    }

    .category-strip {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 8px;
        margin-bottom: 38px
    }

    .category-tile {
        padding: 14px
    }

    .tool-grid {
        grid-template-columns: 1fr;
        gap: 9px
    }

    .tool-card {
        min-height: 0;
        padding: 14px
    }

    .tool-description {
        font-size: 12px
    }

    .page-title {
        padding: 45px 0 20px
    }

    .page-title h1 {
        font-size: 34px
    }

    .workspace {
        padding: 14px;
        margin: 20px 0 55px
    }

    .workspace-top {
        flex-direction: column
    }

    .privacy-chip {
        font-size: 10px
    }

    .dropzone {
        padding: 24px 12px
    }

    .file-facts {
        gap: 7px 15px
    }

    .settings-grid {
        grid-template-columns: 1fr 1fr
    }

    .footer {
        padding: 35px 16px 18px
    }

    .footer-main {
        grid-template-columns: 1fr 1fr;
        gap: 28px
    }

    .footer-brand {
        grid-column: 1/-1
    }

    .footer-bottom {
        flex-direction: column;
        gap: 5px
    }

    .search-meta {
        align-items: flex-start;
        gap: 10px
    }

    .filter-label select {
        max-width: 150px
    }
}

@media(prefers-reduced-motion:reduce) {

    *,
    *::before,
    *::after {
        scroll-behavior: auto !important;
        transition: none !important;
        animation: none !important
    }
}.crop-editor-viewport {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    min-height: 240px;
    padding: 12px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--bg);
}

.crop-editor-stage {
    position: relative;
    display: inline-block;
    max-width: 100%;
    line-height: 0;
    touch-action: none;
    user-select: none;
}

.crop-editor-stage>img {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 480px;
    object-fit: contain;
    pointer-events: none;
}

.crop-selection {
    position: absolute;
    box-sizing: border-box;
    border: 2px solid #00e887;
    box-shadow: 0 0 0 9999px rgb(0 0 0 / 58%);
    cursor: move;
    touch-action: none;
}

.crop-handle {
    position: absolute;
    display: block;
    width: 12px;
    height: 12px;
    border: 2px solid #00e887;
    border-radius: 3px;
    background: #fff;
    touch-action: none;
}

.crop-handle-nw {
    top: -6px;
    left: -6px;
    cursor: nwse-resize;
}

.crop-handle-ne {
    top: -6px;
    right: -6px;
    cursor: nesw-resize;
}

.crop-handle-sw {
    bottom: -6px;
    left: -6px;
    cursor: nesw-resize;
}

.crop-handle-se {
    right: -6px;
    bottom: -6px;
    cursor: nwse-resize;
}

.crop-handle-n,
.crop-handle-s {
    left: 50%;
    transform: translateX(-50%);
    cursor: ns-resize;
}

.crop-handle-n {
    top: -6px;
}

.crop-handle-s {
    bottom: -6px;
}

.crop-handle-e,
.crop-handle-w {
    top: 50%;
    transform: translateY(-50%);
    cursor: ew-resize;
}

.crop-handle-e {
    right: -6px;
}

.crop-handle-w {
    left: -6px;
}

.crop-dimensions,
.crop-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
}

.crop-dimensions {
    margin-top: 14px;
    font-size: 13px;
}

.crop-dimensions strong {
    font-variant-numeric: tabular-nums;
}

.crop-controls-heading {
    display: flex;
    flex-direction: column;
    gap: 4px;
    grid-column: 1 / -1;
}

.crop-controls-heading span {
    color: var(--muted, #888);
    font-size: 13px;
}

.crop-actions {
    grid-column: 1 / -1;
    margin-top: 8px;
}/* =========================================
   BROBEX PROFESSIONAL TOOL STUDIO
========================================= */

.brobex-studio {
    position: relative;
    isolation: isolate;
    width: 100%;
    overflow: hidden;
    color: #f5f2e9;
    background:
        radial-gradient(ellipse at 50% 0%, rgba(190, 151, 75, 0.10), transparent 48%),
        linear-gradient(180deg, #090909 0%, #0c0c0c 55%, #090909 100%);
    border: 1px solid rgba(202, 169, 104, 0.15);
    border-radius: 24px;
    margin-bottom: 30px;
}

.brobex-studio-glow {
    position: absolute;
    z-index: -1;
    top: -180px;
    left: 50%;
    width: 620px;
    height: 360px;
    transform: translateX(-50%);
    background: radial-gradient(ellipse, rgba(199, 163, 91, 0.13), transparent 70%);
    pointer-events: none;
}

.brobex-studio-inner {
    position: relative;
    max-width: 1120px;
    margin: 0 auto;
    padding: 54px 28px 28px;
}

.brobex-studio-brand {
    text-align: center;
    margin-bottom: 54px;
}

.brobex-studio-brand a {
    display: inline-block;
    font-size: 36px;
    font-weight: 900;
    letter-spacing: 0.24em;
    line-height: 1.2;
    color: transparent;
    background: linear-gradient(110deg, #f5e6bd 5%, #c9a45e 48%, #f1d99e 85%);
    background-clip: text;
    -webkit-background-clip: text;
    text-decoration: none;
}

.brobex-studio-brand a span {
    color: #d6b46f;
}

.brobex-studio-brand p {
    margin-top: 12px;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.32em;
    color: rgba(225, 207, 166, 0.55);
}

.brobex-studio-heading {
    max-width: 760px;
    margin: 0 auto 38px;
    text-align: center;
}

.brobex-studio-category {
    display: inline-flex;
    align-items: center;
    padding: 8px 14px;
    border: 1px solid rgba(204, 171, 106, 0.23);
    border-radius: 999px;
    background: rgba(204, 171, 106, 0.06);
    color: #d9bd83;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.19em;
}

.brobex-studio-heading h1 {
    margin: 22px 0 12px;
    font-size: clamp(34px, 5vw, 58px);
    font-weight: 700;
    letter-spacing: -0.055em;
    line-height: 1.08;
    color: transparent;
    background: linear-gradient(105deg, #fff1ce 5%, #cba65e 48%, #f0d9a2 90%);
    background-clip: text;
    -webkit-background-clip: text;
}

.brobex-studio-heading h1 span {
    color: #cba65e;
}

.brobex-studio-heading>p {
    max-width: 590px;
    margin: 0 auto;
    color: rgba(238, 235, 226, 0.58);
    font-size: 14px;
    line-height: 1.9;
}

.brobex-studio-status {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-top: 20px;
    color: rgba(238, 235, 226, 0.65);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.13em;
}

.brobex-studio-status>span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
}

.brobex-studio-status .is-ready {
    background: #83b99a;
    box-shadow: 0 0 12px rgba(131, 185, 154, 0.5);
}

.brobex-studio-status .is-limited {
    background: #d5a65c;
}

.brobex-studio-steps {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 22px;
    margin-top: 42px;
    padding: 22px 10px;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
}

.brobex-studio-steps>div {
    display: flex;
    align-items: center;
    gap: 10px;
}

.brobex-studio-steps span {
    color: #d3b477;
    font-size: 12px;
    font-weight: 800;
}

.brobex-studio-steps p {
    color: rgba(238, 235, 226, 0.65);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.16em;
}

.brobex-studio-steps>i {
    width: 35px;
    height: 1px;
    background: rgba(204, 171, 106, 0.3);
}

.brobex-studio-footer {
    padding-top: 24px;
    text-align: center;
    color: rgba(238, 235, 226, 0.32);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.2em;
}

@media (max-width: 600px) {
    .brobex-studio {
        border-radius: 16px;
    }

    .brobex-studio-inner {
        padding: 38px 16px 22px;
    }

    .brobex-studio-brand {
        margin-bottom: 38px;
    }

    .brobex-studio-brand a {
        font-size: 29px;
    }

    .brobex-studio-brand p {
        font-size: 8px;
        letter-spacing: 0.22em;
    }

    .brobex-studio-steps {
        gap: 9px;
    }

    .brobex-studio-steps>div {
        gap: 5px;
    }

    .brobex-studio-steps>i {
        width: 13px;
    }

    .brobex-studio-steps p {
        font-size: 8px;
        letter-spacing: 0.08em;
    }

    .brobex-studio-footer {
        font-size: 8px;
        letter-spacing: 0.12em;
    }
}
/* BROBEX image tool directory */
.image-directory {
    width: 100%;
    margin-top: 22px;
}

.directory-search {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    min-height: 54px;
    padding: 0 17px;
    border: 1px solid var(--line);
    border-radius: 13px;
    background: var(--surface);
    color: var(--muted);
}

.directory-search input {
    flex: 1;
    min-width: 0;
    height: 50px;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 14px;
}

.directory-search input::placeholder {
    color: var(--muted);
    opacity: .8;
}

.directory-search button {
    border: 0;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
}

.directory-results {
    margin: 13px 2px 22px;
    color: var(--muted);
    font-size: 12px;
}

.directory-categories {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
}

.directory-category {
    min-width: 0;
    padding: 21px;
    border: 1px solid var(--line);
    border-radius: 15px;
    background: var(--surface);
}

.directory-category-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 15px;
    padding-bottom: 13px;
    border-bottom: 1px solid var(--line);
}

.directory-category-heading h3 {
    margin: 0;
    color: var(--ink);
    font-size: 16px;
    font-weight: 750;
    line-height: 1.4;
}

.directory-category-heading > span {
    display: grid;
    place-items: center;
    min-width: 27px;
    height: 27px;
    padding: 0 7px;
    border-radius: 8px;
    background: var(--soft);
    color: var(--muted);
    font-size: 11px;
    font-weight: 700;
}

.directory-tool-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 7px;
}

.directory-tool {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 7px;
    min-width: 0;
    min-height: 39px;
    padding: 9px 10px;
    border: 1px solid transparent;
    border-radius: 8px;
    color: var(--ink);
    font-size: 12px;
    font-weight: 600;
    line-height: 1.4;
    text-decoration: none;
    overflow-wrap: anywhere;
    transition: background .16s ease, border-color .16s ease;
}

.directory-tool svg {
    flex: 0 0 auto;
    opacity: .45;
}

.directory-tool:hover {
    border-color: var(--line);
    background: var(--soft);
}

.directory-tool-unavailable {
    color: var(--muted);
    cursor: default;
}

.directory-empty {
    padding: 35px 15px;
    border: 1px dashed var(--line);
    border-radius: 12px;
    color: var(--muted);
    text-align: center;
    font-size: 14px;
}

@media (max-width: 900px) {
    .directory-categories {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 640px) {
    .directory-category {
        padding: 15px;
    }

    .directory-category-heading h3 {
        font-size: 15px;
    }

    .directory-tool-list {
        grid-template-columns: 1fr;
        gap: 5px;
    }

    .directory-tool {
        min-height: 40px;
        padding: 10px;
        font-size: 13px;
    }

    .directory-search {
        min-height: 50px;
        padding: 0 12px;
    }

    .directory-search input {
        height: 46px;
        font-size: 13px;
    }
}

@media (max-width: 640px) {
    .directory-search {
        min-height: 50px;
        padding: 0 12px;
    }

    .directory-search input {
        height: 46px;
        font-size: 13px;
    }
}

/* BROBEX Passport Photo Maker */
.passport-workspace {
    --passport-accent: #8bcf75;
}

.passport-local-badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 8px 11px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    font-size: 12px;
    white-space: nowrap;
}

.passport-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(270px, .85fr);
    gap: 18px;
    margin-top: 22px;
}

.passport-preview-panel,
.passport-settings {
    min-width: 0;
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--surface);
}

.passport-panel-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 16px;
}

.passport-panel-heading strong {
    font-size: 14px;
}

.passport-panel-heading p {
    margin: 3px 0 0;
    color: var(--muted);
    font-size: 12px;
}

.passport-dimensions {
    color: var(--muted);
    font-size: 11px;
    white-space: nowrap;
}

.passport-upload {
    display: flex;
    width: 100%;
    min-height: 340px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 24px;
    border: 1px dashed var(--line);
    border-radius: 12px;
    background: var(--bg);
    color: var(--muted);
    cursor: pointer;
}

.passport-upload:hover {
    border-color: #70b85c;
}

.passport-upload svg {
    color: #70b85c;
}

.passport-upload strong {
    color: var(--ink);
    font-size: 16px;
}

.passport-upload span {
    font-size: 12px;
    text-align: center;
}

.passport-canvas-wrap {
    display: grid;
    min-height: 340px;
    place-items: center;
    overflow: auto;
    padding: 20px;
    border-radius: 12px;
    background:
        linear-gradient(45deg, var(--soft) 25%, transparent 25%),
        linear-gradient(-45deg, var(--soft) 25%, transparent 25%),
        linear-gradient(45deg, transparent 75%, var(--soft) 75%),
        linear-gradient(-45deg, transparent 75%, var(--soft) 75%);
    background-size: 20px 20px;
    background-position: 0 0, 0 10px, 10px -10px, -10px 0;
}

.passport-canvas-wrap canvas {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 480px;
    object-fit: contain;
    border: 1px solid var(--line);
    box-shadow: 0 8px 30px #0002;
}

.passport-file-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 13px;
    color: var(--muted);
    font-size: 12px;
}

.passport-file-row span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.passport-file-row button {
    color: var(--ink);
    text-decoration: underline;
    flex-shrink: 0;
}

.passport-settings {
    display: flex;
    flex-direction: column;
    gap: 19px;
}

.passport-setting-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.passport-setting-group > label {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    color: var(--ink);
    font-size: 13px;
    font-weight: 650;
}

.passport-setting-group select {
    width: 100%;
    min-height: 42px;
    padding: 0 11px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--bg);
    color: var(--ink);
}

.passport-setting-group input[type="range"] {
    width: 100%;
    accent-color: #70b85c;
}

.passport-color-row {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--muted);
    font-size: 12px;
}

.passport-color-row input {
    width: 48px;
    height: 38px;
    padding: 3px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--bg);
}

.passport-swatches {
    display: flex;
    gap: 9px;
}

.passport-swatches button {
    width: 25px;
    height: 25px;
    border: 1px solid var(--line);
    border-radius: 50%;
    cursor: pointer;
}

.passport-help {
    color: var(--muted);
    font-size: 11px;
    line-height: 1.6;
}

.passport-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
}

.passport-actions button {
    display: inline-flex;
    min-height: 42px;
    align-items: center;
    justify-content: center;
    gap: 7px;
    padding: 0 13px;
    border: 1px solid var(--line);
    border-radius: 8px;
    font-size: 12px;
    font-weight: 650;
    cursor: pointer;
}

.passport-actions button:disabled {
    cursor: not-allowed;
    opacity: .45;
}

.passport-actions .button-dark {
    background: var(--ink);
    color: var(--bg);
}

.passport-actions .button-light {
    background: var(--bg);
    color: var(--ink);
}

@media (max-width: 760px) {
    .passport-layout {
        grid-template-columns: minmax(0, 1fr);
    }

    .passport-preview-panel,
    .passport-settings {
        padding: 14px;
    }

    .passport-upload,
    .passport-canvas-wrap {
        min-height: 260px;
    }
}

@media (max-width: 420px) {
    .passport-panel-heading {
        flex-direction: column;
    }

    .passport-actions {
        flex-direction: column;
    }

    .passport-actions button {
        width: 100%;
    }

    .passport-local-badge {
        white-space: normal;
    }
}

/* BROBEX directory: responsive two-column tool layout */
.image-directory,
.directory-categories,
.directory-category,
.directory-tool-list {
    width: 100%;
    min-width: 0;
    max-width: 100%;
}

.directory-categories {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
}

.directory-tool-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 9px;
}

.directory-tool {
    min-width: 0;
    max-width: 100%;
    min-height: 48px;
    overflow: hidden;
    overflow-wrap: anywhere;
    word-break: normal;
    line-height: 1.4;
}

.directory-tool span {
    min-width: 0;
    overflow-wrap: anywhere;
}

.directory-category {
    padding: clamp(12px, 2vw, 21px);
}

.directory-search {
    min-width: 0;
    max-width: 100%;
}

@media (max-width: 700px) {
    .directory-categories {
        grid-template-columns: minmax(0, 1fr);
        gap: 13px;
    }

    .directory-tool-list {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 7px;
    }

    .directory-tool {
        min-height: 46px;
        padding: 9px;
        font-size: 12px;
    }

    .directory-category {
        padding: 14px;
    }
}

@media (max-width: 360px) {
    .directory-tool {
        gap: 4px;
        padding: 8px 7px;
        font-size: 11px;
    }

    .directory-tool svg {
        width: 12px;
        height: 12px;
    }
}


/* BROBEX clean tool directory */
.image-directory {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    margin-top: 20px;
}

.directory-search {
    width: 100%;
    max-width: 100%;
    min-width: 0;
}

.directory-results {
    margin: 14px 0 0;
    color: var(--muted);
    font-size: 13px;
}

.directory-categories {
    display: flex;
    flex-direction: column;
    gap: 34px;
    width: 100%;
    min-width: 0;
    margin-top: 30px;
}

.directory-category {
    width: 100%;
    min-width: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
}

.directory-category-heading {
    display: flex;
    align-items: center;
    margin: 0 0 14px;
    padding: 0 0 12px;
    border-bottom: 1px solid var(--line);
}

.directory-category-heading h2 {
    margin: 0;
    color: var(--ink);
    font-size: clamp(19px, 2vw, 23px);
    font-weight: 750;
    line-height: 1.3;
    letter-spacing: -0.025em;
}

.directory-tool-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 28px;
    width: 100%;
    min-width: 0;
}

.directory-tool {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    width: 100%;
    min-width: 0;
    min-height: 48px;
    padding: 10px 4px;
    overflow-wrap: anywhere;
    border: 0;
    border-bottom: 1px solid var(--line);
    border-radius: 0;
    background: transparent;
    color: var(--ink);
    font-size: 14px;
    font-weight: 550;
    line-height: 1.45;
    text-decoration: none;
    transition: color .18s ease, padding-left .18s ease;
}

.directory-tool:hover {
    padding-left: 9px;
    background: transparent;
    color: var(--accent);
}

.directory-tool span {
    min-width: 0;
    overflow-wrap: anywhere;
}

.directory-empty {
    margin-top: 24px;
    padding: 24px 0;
    color: var(--muted);
    text-align: center;
}

@media (max-width: 520px) {
    .directory-categories {
        gap: 27px;
        margin-top: 25px;
    }

    .directory-tool-list {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0 9px;
    }

    .directory-tool {
        min-height: 46px;
        padding: 9px 2px;
        font-size: 12px;
    }

    .directory-category-heading h2 {
        font-size: 19px;
    }
}

/* =========================================
   BROBEX — PREMIUM IMAGE TOOL DIRECTORY
   ========================================= */

.image-directory {
  width: 100%;
  max-width: 1120px;
  margin-inline: auto;
}

.directory-intro {
  text-align: center;
  max-width: 680px;
  margin: 0 auto 34px;
}

.directory-eyebrow {
  display: inline-block;
  margin-bottom: 12px;
  color: var(--accent);
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.2em;
  text-transform: uppercase;
}

.directory-main-title {
  margin: 0;
  font-size: clamp(25px, 4vw, 36px);
  font-weight: 750;
  letter-spacing: -0.045em;
  line-height: 1.15;
}

.directory-main-description {
  max-width: 520px;
  margin: 12px auto 0;
  color: var(--muted);
  font-size: 14px;
  line-height: 1.75;
}

.directory-search {
  display: flex;
  align-items: center;
  gap: 13px;
  width: 100%;
  max-width: 620px;
  min-height: 58px;
  margin: 0 auto 44px;
  padding: 0 19px;
  border: 1px solid var(--line);
  border-radius: 14px;
  background: var(--surface, transparent);
  color: var(--muted);
  transition: border-color 180ms ease, box-shadow 180ms ease;
}

.directory-search:focus-within {
  border-color: var(--accent);
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 12%, transparent);
}

.directory-search input {
  flex: 1;
  width: 100%;
  min-width: 0;
  border: 0;
  outline: 0;
  background: transparent;
  color: inherit;
  font: inherit;
  font-size: 14px;
}

.directory-search input::placeholder {
  color: var(--muted);
  opacity: 0.75;
}

.directory-search button {
  border: 0;
  background: transparent;
  color: var(--accent);
  font: inherit;
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
}

.directory-results {
  margin: -28px 0 28px;
  color: var(--muted);
  text-align: center;
  font-size: 12px;
}

.directory-categories {
  display: flex;
  flex-direction: column;
  gap: 42px;
  margin-top: 0;
}

.directory-category {
  min-width: 0;
  padding: 0;
  border: 0;
  background: transparent;
}

.directory-category-heading {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 54px;
  margin-bottom: 14px;
  padding: 0 52px 15px;
  border-bottom: 1px solid var(--line);
  text-align: center;
}

.directory-category-heading h2 {
  margin: 0;
  font-size: clamp(17px, 2.2vw, 21px);
  font-weight: 750;
  letter-spacing: -0.035em;
  line-height: 1.4;
}

.directory-category-index {
  position: absolute;
  left: 0;
  top: 3px;
  color: var(--accent);
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.12em;
}

.directory-category-count {
  position: absolute;
  right: 0;
  top: 5px;
  color: var(--muted);
  font-size: 9px;
  font-weight: 750;
  letter-spacing: 0.1em;
}

.directory-tool-list {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  column-gap: 30px;
}

.directory-tool {
  display: flex;
  align-items: center;
  gap: 12px;
  min-width: 0;
  min-height: 55px;
  padding: 10px 5px;
  border: 0;
  border-bottom: 1px solid var(--line);
  background: transparent;
  color: inherit;
  text-decoration: none;
  transition:
    color 180ms ease,
    background 180ms ease,
    padding 180ms ease;
}

.directory-tool-number {
  flex: 0 0 23px;
  color: var(--muted);
  font-size: 10px;
  font-weight: 650;
  font-variant-numeric: tabular-nums;
  opacity: 0.75;
}

.directory-tool-name {
  flex: 1;
  min-width: 0;
  font-size: 13px;
  font-weight: 550;
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.directory-tool-action {
  display: grid;
  flex: 0 0 28px;
  width: 28px;
  height: 28px;
  place-items: center;
  border: 1px solid var(--line);
  border-radius: 50%;
  color: var(--muted);
  transition:
    color 180ms ease,
    border-color 180ms ease,
    background 180ms ease,
    transform 180ms ease;
}

.directory-tool:hover {
  padding-left: 10px;
  color: var(--accent);
}

.directory-tool:hover .directory-tool-action {
  border-color: var(--accent);
  background: color-mix(in srgb, var(--accent) 10%, transparent);
  color: var(--accent);
  transform: translate(2px, -2px);
}

.directory-tool--unavailable {
  cursor: default;
  color: var(--muted);
  opacity: 0.72;
}

.directory-tool--unavailable .directory-tool-name {
  opacity: 0.8;
}

.directory-tool-status {
  display: inline-flex;
  flex: 0 0 auto;
  align-items: center;
  gap: 5px;
  padding: 5px 8px;
  border: 1px solid var(--line);
  border-radius: 6px;
  color: var(--muted);
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.015em;
  white-space: nowrap;
}

.directory-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 9px;
  min-height: 180px;
  border: 1px solid var(--line);
  border-radius: 14px;
  color: var(--muted);
  text-align: center;
}

.directory-empty p {
  margin: 0;
  color: inherit;
  font-size: 15px;
  font-weight: 700;
}

.directory-empty span {
  font-size: 12px;
}

@media (max-width: 640px) {
  .directory-intro {
    margin-bottom: 25px;
  }

  .directory-search {
    min-height: 53px;
    margin-bottom: 34px;
    padding-inline: 14px;
  }

  .directory-categories {
    gap: 32px;
  }

  .directory-category-heading {
    min-height: 48px;
    margin-bottom: 10px;
    padding-inline: 37px;
  }

  .directory-category-heading h2 {
    font-size: 17px;
  }

  .directory-category-index,
  .directory-category-count {
    font-size: 8px;
  }

  .directory-tool-list {
    grid-template-columns: minmax(0, 1fr);
  }

  .directory-tool {
    min-height: 51px;
  }

  .directory-tool-name {
    font-size: 13px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .directory-search,
  .directory-tool,
  .directory-tool-action {
    transition: none;
  }
}


/* =========================================
   BROBEX PREMIUM CATEGORY PAGES
   ========================================= */

.category-page {
    width: 100%;
    max-width: 1160px;
    min-width: 0;
    margin-inline: auto;
}

.category-page-title {
    padding: clamp(48px, 7vw, 82px) 0 34px;
    text-align: center;
}

.category-breadcrumb {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 7px;
    margin-bottom: 28px;
    font-size: 12px;
    letter-spacing: .015em;
}

.category-breadcrumb a {
    color: var(--muted);
    text-decoration: none;
    transition: color .2s ease;
}

.category-breadcrumb a:hover {
    color: var(--accent);
}

.category-eyebrow {
    display: inline-block;
    margin-bottom: 13px;
    color: var(--accent);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .2em;
    text-transform: uppercase;
}

.category-page-title h1 {
    margin: 0;
    font-size: clamp(34px, 5vw, 55px);
    font-weight: 780;
    line-height: 1.08;
    letter-spacing: -.055em;
    text-wrap: balance;
}

.category-page-title p {
    max-width: 620px;
    margin: 15px auto 0;
    color: var(--muted);
    font-size: clamp(13px, 1.5vw, 15px);
    line-height: 1.8;
    text-wrap: pretty;
}

.category-page-content {
    width: 100%;
    max-width: 1120px;
    margin-inline: auto;
    padding: 0 0 90px;
}

.category-page .search-section {
    width: 100%;
}

.category-page .search-box {
    width: 100%;
    max-width: 650px;
    min-height: 59px;
    margin-inline: auto;
    padding-inline: 19px;
    border-radius: 13px;
    transition:
        border-color .2s ease,
        box-shadow .2s ease,
        background .2s ease;
}

.category-page .search-box:focus-within {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 11%, transparent);
}

.category-page .search-box input {
    font-size: 14px;
}

.category-page .search-meta {
    width: 100%;
    max-width: 650px;
    margin: 17px auto 23px;
}

.category-page .tool-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 13px;
    width: 100%;
}

.category-page .tool-card {
    min-width: 0;
    min-height: 145px;
    padding: 21px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--surface);
    transition:
        border-color .22s ease,
        background .22s ease,
        transform .22s ease,
        box-shadow .22s ease;
}

.category-page .tool-card:hover {
    border-color: var(--accent);
    background: var(--surface);
    transform: translateY(-3px);
    box-shadow: 0 12px 32px color-mix(in srgb, var(--accent) 7%, transparent);
}

.category-page .tool-card:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
}

.category-page .tool-card-copy {
    flex: 1;
}

.category-page .tool-name {
    font-size: 14px;
    font-weight: 700;
    line-height: 1.45;
}

.category-page .tool-description {
    font-size: 12px;
    line-height: 1.65;
}

.category-page .card-arrow {
    flex: 0 0 auto;
    transition: transform .2s ease, color .2s ease;
}

.category-page .tool-card:hover .card-arrow {
    color: var(--accent);
    transform: translate(2px, -2px);
}

.category-page .empty-state {
    max-width: 650px;
    margin: 35px auto;
    border-radius: 14px;
}

@media (max-width: 900px) {
    .category-page .tool-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 640px) {
    .category-page-title {
        padding: 43px 0 25px;
    }

    .category-breadcrumb {
        margin-bottom: 23px;
    }

    .category-page-title h1 {
        font-size: clamp(31px, 9vw, 40px);
    }

    .category-page-title p {
        max-width: 480px;
        padding-inline: 8px;
        line-height: 1.7;
    }

    .category-page-content {
        padding-bottom: 65px;
    }

    .category-page .tool-grid {
        grid-template-columns: minmax(0, 1fr);
        gap: 10px;
    }

    .category-page .tool-card {
        min-height: 0;
        padding: 16px;
    }

    .category-page .search-meta {
        gap: 10px;
        margin-bottom: 17px;
    }
}

@media (prefers-reduced-motion: reduce) {
    .category-page .tool-card,
    .category-page .card-arrow,
    .category-breadcrumb a {
        transition: none;
    }

    .category-page .tool-card:hover {
        transform: none;
    }
}
/* ==========================================================
   BROBEX PREMIUM TOOL STUDIO — SHARED INTERFACE UPGRADE
   Applies to existing workspaces without replacing functionality.
   ========================================================== */

.workspace {
  position: relative;
  isolation: isolate;
  overflow: hidden;
  border: 1px solid color-mix(in srgb, var(--line) 75%, #c77b53 25%);
  border-radius: 24px;
  background:
    radial-gradient(
      ellipse at 0% 0%,
      rgba(199, 123, 83, 0.075),
      transparent 42%
    ),
    var(--surface);
  box-shadow:
    0 18px 55px rgba(0, 0, 0, 0.09),
    inset 0 1px 0 rgba(255, 255, 255, 0.035);
  transition: border-color 180ms ease, box-shadow 180ms ease;
}

.workspace:focus-within {
  border-color: color-mix(in srgb, var(--line) 55%, #c77b53 45%);
}

.workspace-top {
  gap: 18px;
  margin-bottom: 24px;
}

.workspace-columns {
  align-items: start;
  gap: 22px;
}

.workspace .dropzone {
  position: relative;
  display: flex;
  min-height: 190px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12px;
  padding: 28px 20px;
  border: 1.5px dashed color-mix(in srgb, var(--line) 55%, #c77b53 45%);
  border-radius: 19px;
  background:
    linear-gradient(
      145deg,
      rgba(199, 123, 83, 0.075),
      transparent 65%
    ),
    color-mix(in srgb, var(--surface) 94%, #c77b53 6%);
  text-align: center;
  cursor: pointer;
  transition:
    border-color 180ms ease,
    background 180ms ease,
    transform 180ms ease,
    box-shadow 180ms ease;
}

.workspace .dropzone:hover {
  border-color: #c77b53;
  background-color: color-mix(in srgb, var(--surface) 88%, #c77b53 12%);
  box-shadow: 0 10px 30px rgba(199, 123, 83, 0.09);
}

.workspace .dropzone:focus-within {
  outline: 2px solid #c77b53;
  outline-offset: 4px;
}

.workspace .dropzone input[type="file"] {
  max-width: 100%;
  font: inherit;
  font-size: 13px;
  cursor: pointer;
}

.workspace input[type="file"]::file-selector-button {
  margin: 0 10px 0 0;
  padding: 10px 16px;
  border: 1px solid rgba(199, 123, 83, 0.45);
  border-radius: 10px;
  background: linear-gradient(135deg, #c77b53, #a95e3c);
  color: #fff;
  font: inherit;
  font-size: 13px;
  font-weight: 700;
  cursor: pointer;
  transition: filter 180ms ease, transform 180ms ease;
}

.workspace input[type="file"]::file-selector-button:hover {
  filter: brightness(1.12);
  transform: translateY(-1px);
}

.workspace button,
.workspace .workspace-actions a,
.workspace a[role="button"] {
  min-height: 42px;
  border-radius: 11px;
  font-weight: 650;
  transition:
    transform 160ms ease,
    box-shadow 160ms ease,
    border-color 160ms ease,
    background 160ms ease,
    filter 160ms ease;
}

.workspace button:hover:not(:disabled),
.workspace .workspace-actions a:hover,
.workspace a[role="button"]:hover {
  transform: translateY(-2px);
}

.workspace button:active:not(:disabled),
.workspace .workspace-actions a:active {
  transform: translateY(0);
}

.workspace button:focus-visible,
.workspace a:focus-visible,
.workspace input:focus-visible,
.workspace select:focus-visible,
.workspace textarea:focus-visible {
  outline: 2px solid #c77b53;
  outline-offset: 3px;
}

.workspace button:disabled {
  cursor: not-allowed;
  opacity: 0.48;
  transform: none;
}

.workspace input:not([type="file"]):not([type="checkbox"]):not([type="radio"]),
.workspace select,
.workspace textarea {
  max-width: 100%;
  border-radius: 11px;
  transition: border-color 160ms ease, box-shadow 160ms ease;
}

.workspace input:not([type="file"]):focus,
.workspace select:focus,
.workspace textarea:focus {
  border-color: #c77b53;
  box-shadow: 0 0 0 3px rgba(199, 123, 83, 0.12);
}

.workspace .preview-panel,
.workspace .settings-panel {
  border-radius: 18px;
  border-color: color-mix(in srgb, var(--line) 80%, #c77b53 20%);
}

.workspace .preview-panel {
  overflow: hidden;
}

.workspace .workspace-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  align-items: center;
}

.workspace .workspace-actions button,
.workspace .workspace-actions a {
  justify-content: center;
}

.workspace .privacy-line {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px;
}

.integration-notice {
  border-radius: 20px;
  border-color: color-mix(in srgb, var(--line) 75%, #c77b53 25%);
  background:
    radial-gradient(
      ellipse at top left,
      rgba(199, 123, 83, 0.09),
      transparent 65%
    ),
    var(--surface);
}

@media (min-width: 901px) {
  .workspace {
    padding: 28px;
  }
}

@media (max-width: 900px) {
  .workspace-columns {
    grid-template-columns: minmax(0, 1fr);
  }
}

@media (max-width: 600px) {
  .workspace {
    padding: 16px;
    margin-top: 20px;
    margin-bottom: 45px;
    border-radius: 18px;
  }

  .workspace .dropzone {
    min-height: 155px;
    padding: 22px 14px;
    border-radius: 15px;
  }

  .workspace .workspace-actions {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .workspace .workspace-actions button,
  .workspace .workspace-actions a {
    width: 100%;
  }

  .workspace button {
    min-height: 44px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .workspace,
  .workspace *,
  .integration-notice {
    scroll-behavior: auto !important;
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

/* END BROBEX PREMIUM TOOL STUDIO */

/* ==========================================================
   BROBEX — CONSISTENT PREMIUM UPLOAD EXPERIENCE
   Existing file handlers and processing logic are preserved.
   ========================================================== */

/* Shared upload surfaces */
.workspace .dropzone,
.image-text-upload,
.translate-upload,
[role="button"][aria-label="Upload an image"] {
    box-sizing: border-box;
    position: relative;
    border: 1px dashed rgba(199, 123, 83, 0.55);
    border-radius: 20px;
    background:
        radial-gradient(
            ellipse at top,
            rgba(199, 123, 83, 0.12),
            transparent 72%
        ),
        var(--surface);
    transition:
        border-color 180ms ease,
        background 180ms ease,
        box-shadow 180ms ease,
        transform 180ms ease;
}

/* Hover and drag-ready states */
.workspace .dropzone:hover,
.image-text-upload:hover,
.translate-upload:hover,
[role="button"][aria-label="Upload an image"]:hover {
    border-color: #d18a64;
    box-shadow: 0 12px 35px rgba(199, 123, 83, 0.12);
}

.workspace .dropzone:focus-within,
.image-text-upload:focus-visible,
.translate-upload:focus-visible,
[role="button"][aria-label="Upload an image"]:focus-visible {
    outline: 2px solid #c77b53;
    outline-offset: 4px;
}

/* Upload typography */
.workspace .dropzone strong,
.image-text-upload strong,
.translate-upload strong {
    font-size: 15px;
    font-weight: 750;
    letter-spacing: -0.02em;
}

.workspace .dropzone > span,
.image-text-upload > span,
.translate-upload > span {
    line-height: 1.7;
}

/* File selection buttons */
.workspace input[type="file"]::file-selector-button {
    border: 0;
    border-radius: 10px;
    background: linear-gradient(135deg, #c77b53, #a95e3c);
    color: #fff;
    font-weight: 700;
    padding: 10px 15px;
    cursor: pointer;
}

/* Custom upload buttons */
.image-text-upload b,
.translate-upload-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 43px;
    padding: 0 20px;
    border: 1px solid rgba(199, 123, 83, 0.5);
    border-radius: 11px;
    background: linear-gradient(135deg, #c77b53, #a95e3c);
    color: #fff;
    font-size: 13px;
    font-weight: 750;
    box-shadow: 0 6px 18px rgba(199, 123, 83, 0.14);
    transition: transform 160ms ease, filter 160ms ease;
}

.image-text-upload:hover b,
.translate-upload:hover .translate-upload-button {
    filter: brightness(1.12);
    transform: translateY(-1px);
}

/* Selected file panels */
.image-text-file-panel,
.translate-image-preview,
.workspace .preview-panel {
    border: 1px solid rgba(199, 123, 83, 0.2);
    border-radius: 17px;
    overflow: hidden;
}

.image-text-filebar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-width: 0;
}

.image-text-filebar > div {
    min-width: 0;
}

.image-text-filebar span {
    overflow-wrap: anywhere;
}

.image-text-filebar button,
.image-text-result-head button,
.translate-result-card button {
    min-height: 38px;
    padding: 8px 12px;
    border: 1px solid rgba(199, 123, 83, 0.25);
    border-radius: 10px;
    transition: background 160ms ease, border-color 160ms ease;
}

.image-text-filebar button:hover,
.image-text-result-head button:hover,
.translate-result-card button:hover {
    border-color: #c77b53;
}

/* Settings and action areas */
.image-text-controls,
.translate-settings,
.translate-actions,
.image-text-result-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
}

.image-text-controls > *,
.translate-settings > * {
    min-width: 0;
    flex: 1 1 180px;
}

.image-text-primary,
.translate-primary {
    min-height: 44px;
    border-radius: 11px;
    font-weight: 750;
    transition: transform 160ms ease, filter 160ms ease;
}

.image-text-primary:hover:not(:disabled),
.translate-primary:hover:not(:disabled) {
    filter: brightness(1.1);
    transform: translateY(-2px);
}

.image-text-primary:disabled,
.translate-primary:disabled {
    cursor: not-allowed;
    opacity: 0.55;
}

/* Preview images */
.image-text-preview img,
.translate-image-preview img {
    display: block;
    max-width: 100%;
    max-height: 560px;
    margin-inline: auto;
    object-fit: contain;
}

/* Chart Maker CSV import and other workspace buttons */
.workspace button,
.workspace-actions button {
    touch-action: manipulation;
}

.workspace button:focus-visible,
.workspace a:focus-visible {
    outline: 2px solid #c77b53;
    outline-offset: 3px;
}

/* Mobile upload layout */
@media (max-width: 600px) {
    .image-text-upload,
    .translate-upload,
    .workspace .dropzone {
        width: 100%;
        min-height: 150px;
        padding: 22px 14px;
        border-radius: 16px;
    }

    .image-text-controls,
    .translate-actions {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
    }

    .image-text-controls button,
    .translate-actions button {
        width: 100%;
        justify-content: center;
    }

    .image-text-filebar {
        align-items: flex-start;
    }

    .image-text-filebar span {
        overflow-wrap: anywhere;
    }
}

@media (prefers-reduced-motion: reduce) {
    .image-text-upload,
    .translate-upload,
    .workspace .dropzone,
    .image-text-upload *,
    .translate-upload * {
        transition: none !important;
    }
}

/* END BROBEX CONSISTENT PREMIUM UPLOAD EXPERIENCE */

/* BROBEX shared category directory layout */
.tool-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 10px;
}

.category-directory-tool {
  display: flex;
  align-items: center;
  min-width: 0;
  gap: 16px;
  text-decoration: none;
}

.category-directory-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  gap: 5px;
}

.category-directory-description {
  display: block;
  color: var(--muted, #929aa2);
  font-size: 0.85rem;
  line-height: 1.5;
}

.category-directory-tool .status {
  width: fit-content;
}

@media (max-width: 600px) {
  .category-directory-tool {
    gap: 10px;
  }

  .category-directory-description {
    font-size: 0.78rem;
  }
}

/* BROBEX category directory — aligned with homepage */
.category-page .tool-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  align-items: stretch;
  gap: 0 28px;
  width: 100%;
  min-width: 0;
}

.category-page .category-directory-tool {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 12px;
  width: 100%;
  min-width: 0;
  min-height: 54px;
  padding: 10px 4px;
  border: 0;
  border-bottom: 1px solid var(--line);
  border-radius: 0;
  background: transparent;
  box-shadow: none;
  color: inherit;
  text-decoration: none;
  transition: color .2s ease, padding .2s ease;
}

.category-page .category-directory-tool:hover {
  padding-left: 10px;
  border-color: var(--line);
  background: transparent;
  box-shadow: none;
  transform: none;
  color: var(--accent);
}

.category-page .category-directory-tool:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 3px;
  border-radius: 6px;
}

.category-page .category-directory-tool .directory-tool-number {
  flex: 0 0 23px;
  width: 23px;
  color: var(--muted);
  font-size: 10px;
  font-weight: 650;
  letter-spacing: .08em;
}

.category-page .category-directory-copy {
  display: block;
  flex: 1 1 auto;
  min-width: 0;
}

.category-page .category-directory-tool .directory-tool-name {
  display: block;
  min-width: 0;
  overflow-wrap: anywhere;
  font-size: 13px;
  line-height: 1.5;
  font-weight: 550;
}

.category-page .category-directory-tool .directory-tool-action {
  display: grid;
  flex: 0 0 28px;
  place-items: center;
  width: 28px;
  height: 28px;
  border: 1px solid var(--line);
  border-radius: 50%;
  color: var(--muted);
  transition: .2s ease;
}

.category-page .category-directory-tool:hover .directory-tool-action {
  border-color: var(--accent);
  background: color-mix(in srgb, var(--accent) 10%, transparent);
  color: var(--accent);
  transform: translate(2px, -2px);
}

@media (max-width: 640px) {
  .category-page .tool-grid {
    grid-template-columns: minmax(0, 1fr);
    gap: 0;
  }

  .category-page .category-directory-tool {
    min-height: 50px;
    padding: 9px 2px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .category-page .category-directory-tool,
  .category-page .category-directory-tool .directory-tool-action {
    transition: none;
  }
}

/* Automatic compression tool: hide redundant manual processing action */
.auto-compress-hidden {
  display: none !important;
}
