.tool-workspace-shell {
  width: 100%;
  min-width: 0;
}

.tool-workspace-shell>* {
  min-width: 0;
}

.tool-detail-content h2 {
  margin: 0 0 13px;
  color: var(--ink);
  font-size: clamp(18px, 2vw, 22px);
  font-weight: 780;
  letter-spacing: -.035em;
}

.tool-detail-content p {
  color: var(--muted);
  line-height: 1.75;
}

.tool-detail-content .privacy-line {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  margin: 18px 0 28px;
  padding: 13px 15px;
  border: 1px solid var(--line);
  border-radius: 9px;
  background: var(--bg);
  color: var(--muted);
