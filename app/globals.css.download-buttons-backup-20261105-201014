  background: var(--soft);
}

.hero-art-chip {
  position: absolute;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 11px 14px;
  border: 1px solid var(--line);
  border-radius: 10px;
  background: var(--surface);
  color: var(--ink);
  font-size: 12px;
  font-weight: 750;
  box-shadow: var(--shadow);
}

.hero-art-chip svg {
  color: var(--accent);
}

.hero-art-chip-one {
  top: 25px;
  left: -15px;
}

.hero-art-chip-two {
  right: -15px;
  bottom: 22px;
}

.home-popular {
  padding-top: 14px;
  padding-bottom: 68px;
}

.home-section-heading {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 25px;
  margin-bottom: 23px;
}

.home-section-heading h2 {
  margin: 7px 0 6px;
  font-size: clamp(26px, 3vw, 34px);
  letter-spacing: -.045em;
  line-height: 1.15;
}

.home-section-heading p {
  margin: 0;
  color: var(--muted);
  font-size: 14px;
}

.home-text-link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  flex: 0 0 auto;
  color: var(--accent);
  font-size: 13px;
  font-weight: 750;
}

.popular-tool-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
