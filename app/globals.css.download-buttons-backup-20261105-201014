/* ==========================================================================
   BROBEX PREMIUM THEME SYSTEM
   Visual-only refinement: preserves existing components, routes and behavior.
   ========================================================================== */

:root {
  color-scheme: light;
  --bg: #ffffff;
  --surface: #ffffff;
  --ink: #111111;
  --muted: #626262;
  --line: rgba(20, 25, 22, 0.085);
  --soft: #f1f2ef;
  --dark: #171a18;
  --accent: #000000;
  --accent-soft: rgba(199, 123, 83, .10);
  --shadow: 0 12px 34px rgba(25, 32, 27, 0.055);
  --shadow-raised: 0 18px 48px rgba(25, 32, 27, 0.085);
  --page-gradient:
    radial-gradient(ellipse at 8% 0%, rgba(255, 255, 255, .98) 0%, rgba(255, 255, 255, 0) 42%),
    radial-gradient(ellipse at 94% 12%, rgba(228, 232, 226, .42) 0%, rgba(228, 232, 226, 0) 36%),
    linear-gradient(145deg, #ffffff 0%, #fafaf9 48%, #f1f2ef 100%);
  --surface-gradient: linear-gradient(145deg, #ffffff 0%, #fbfcfa 100%);
  --surface-raised: linear-gradient(145deg, #ffffff 0%, #f7f8f6 100%);
  --header-background: rgba(250, 250, 249, .82);
  --focus-ring: rgba(199, 123, 83, .48);
}

:root[data-theme="dark"] {
