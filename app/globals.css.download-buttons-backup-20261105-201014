/* Shared appearance for existing image, PDF and writing workspaces */
.tool-workspace-shell .workspace {
  margin: 0;
  padding: clamp(15px, 2.4vw, 25px);
  border: 1px solid var(--line);
  border-radius: 13px;
  background: var(--surface);
  box-shadow: 0 5px 22px rgba(24, 42, 68, .035);
}

.tool-workspace-shell .workspace-top {
  align-items: center;
  padding-bottom: 15px;
  border-bottom: 1px solid var(--line);
}

.tool-workspace-shell .workspace-top h2 {
  font-size: 19px;
  font-weight: 780;
}

.tool-workspace-shell .workspace-top p {
  color: var(--muted);
  line-height: 1.6;
}

.tool-workspace-shell .dropzone,
.tool-workspace-shell .passport-upload {
  border-color: color-mix(in srgb, var(--accent) 30%, var(--line));
  background: var(--bg);
  transition: border-color .18s ease, background .18s ease;
}

.tool-workspace-shell .dropzone:hover,
.tool-workspace-shell .passport-upload:hover {
  border-color: var(--accent);
  background: var(--accent-soft);
}

.tool-workspace-shell .preview-panel,
.tool-workspace-shell .settings-panel,
.tool-workspace-shell .passport-preview-panel,
.tool-workspace-shell .passport-settings {
  border-color: var(--line);
  border-radius: 11px;
  background: var(--surface);
}

.tool-workspace-shell .settings-panel input:not([type=checkbox]):not([type=range]):not([type=color]),
.tool-workspace-shell .settings-panel select,
.tool-workspace-shell select,
.tool-workspace-shell input:not([type=checkbox]):not([type=range]):not([type=color]):not([type=file]),
.tool-workspace-shell textarea {
  border-color: var(--line);
  border-radius: 8px;
  background: var(--bg);
  color: var(--ink);
}

.tool-workspace-shell button,
.tool-workspace-shell select,
.tool-workspace-shell input,
.tool-workspace-shell textarea {
  font: inherit;
}

.tool-workspace-shell button {
  transition: transform .16s ease, box-shadow .16s ease, border-color .16s ease, background .16s ease;
}

.tool-workspace-shell button:focus-visible,
.tool-workspace-shell input:focus-visible,
.tool-workspace-shell select:focus-visible,
.tool-workspace-shell textarea:focus-visible,
.tool-breadcrumb a:focus-visible {
  outline: 3px solid color-mix(in srgb, var(--accent) 38%, transparent);
