  padding: clamp(17px, 2.5vw, 23px);
  border: 1px solid var(--line);
  border-radius: 12px;
  background: var(--surface);
}

.tool-info-eyebrow {
  display: block;
  margin-bottom: 11px;
  color: var(--accent);
  font-size: 9px;
  font-weight: 850;
  letter-spacing: .14em;
