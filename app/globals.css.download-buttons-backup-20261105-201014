}

.home-directory-section {
  padding-top: 20px;
  padding-bottom: 78px;
  scroll-margin-top: 90px;
}

.directory-intro {
  margin-bottom: 24px;
}

.image-directory {
  margin-top: 0;
}

.directory-search {
  min-height: 58px;
  padding-inline: 18px;
  border-radius: 10px;
  background: var(--surface);
  box-shadow: var(--shadow);
}

.directory-search input {
  font-size: 14px;
}

.directory-categories {
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
  margin-top: 22px;
}

.directory-category {
  padding: 20px;
  border-radius: 11px;
  box-shadow: 0 3px 15px rgba(30, 45, 70, .025);
}

.directory-category-heading {
  justify-content: flex-start;
  margin-bottom: 12px;
  padding-bottom: 12px;
}

.directory-category-index {
  display: grid;
  place-items: center;
  width: 29px;
  height: 29px;
  flex: 0 0 29px;
  border-radius: 8px;
  background: var(--accent-soft);
  color: var(--accent);
  font-size: 10px;
  font-weight: 800;
}

.directory-category-heading h2 {
  margin: 0;
  font-size: 15px;
  font-weight: 750;
  letter-spacing: -.015em;
}

.directory-category-count {
  margin-left: auto;
  color: var(--muted);
  font-size: 9px;
  font-weight: 800;
  letter-spacing: .08em;
}

.directory-tool-list {
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 4px 8px;
}

.directory-tool {
  min-height: 37px;
  padding: 8px 9px;
  border-radius: 7px;
  font-size: 11px;
  font-weight: 600;
}

.directory-tool-number {
  color: var(--muted);
  font-size: 9px;
  opacity: .7;
}

.directory-tool-name {
  flex: 1;
  min-width: 0;
}

.directory-tool-action {
  display: grid;
  place-items: center;
  color: var(--accent);
}

.directory-tool-status {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  color: var(--muted);
  font-size: 9px;
  white-space: nowrap;
}

.directory-tool:hover {
  background: var(--accent-soft);
  border-color: transparent;
}

.directory-tool--unavailable {
  opacity: .72;
}

.directory-results {
  font-size: 12px;
}

.home-privacy-strip {
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
  background: var(--surface);
}

.home-privacy-inner {
  display: flex;
  align-items: center;
  gap: 16px;
  padding-top: 23px;
  padding-bottom: 23px;
}

.home-privacy-icon {
  display: grid;
  place-items: center;
  width: 43px;
  height: 43px;
  flex: 0 0 43px;
  border-radius: 10px;
  background: var(--accent-soft);
  color: var(--accent);
}

.home-privacy-inner>div {
  flex: 1;
  min-width: 0;
}

.home-privacy-inner strong {
  font-size: 13px;
}

.home-privacy-inner p {
  margin: 3px 0 0;
  color: var(--muted);
  font-size: 11px;
}

.home-privacy-inner>a {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  color: var(--accent);
  font-size: 12px;
  font-weight: 750;
  white-space: nowrap;
}

@media (max-width: 980px) {
  .home-hero {
    grid-template-columns: minmax(0, 1fr) minmax(260px, .8fr);
    gap: 28px;
  }

  .popular-tool-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .hero-art-chip-one {
    left: -5px;
  }

  .hero-art-chip-two {
    right: -5px;
  }
}

@media (max-width: 700px) {
  .container {
    width: min(100% - 32px, 560px);
  }

  .home-hero {
    grid-template-columns: 1fr;
    gap: 25px;
    padding-top: 52px;
    padding-bottom: 48px;
  }

  .home-hero h1 {
    font-size: clamp(42px, 11vw, 58px);
  }

  .home-hero-art {
    min-height: 260px;
  }

  .hero-art-window {
    max-width: 390px;
  }

  .hero-art-canvas {
    height: 175px;
  }

  .hero-art-chip-one {
    left: 0;
    top: 8px;
  }

  .hero-art-chip-two {
    right: 0;
    bottom: 4px;
  }

  .home-popular {
    padding-bottom: 48px;
  }

  .home-section-heading {
    align-items: flex-start;
    flex-direction: column;
    gap: 12px;
  }

  .popular-tool-grid {
    gap: 9px;
  }

  .popular-tool-card {
    min-height: 115px;
    padding: 13px;
    gap: 9px;
  }

  .popular-tool-icon {
    width: 34px;
    height: 34px;
    flex-basis: 34px;
  }

  .popular-tool-content strong {
    font-size: 12px;
  }

  .popular-tool-content small {
    font-size: 10px;
  }

  .directory-categories {
    grid-template-columns: 1fr;
    gap: 12px;
  }

  .directory-category {
    padding: 15px;
  }

  .directory-tool-list {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .home-privacy-inner {
    align-items: flex-start;
    flex-wrap: wrap;
  }

  .home-privacy-inner>div {
    flex: 1 1 calc(100% - 65px);
  }

  .home-privacy-inner>a {
    margin-left: 59px;
  }
}

@media (max-width: 390px) {
  .popular-tool-grid {
    grid-template-columns: 1fr;
  }

  .popular-tool-card {
    min-height: 85px;
  }

  .directory-tool-list {
    grid-template-columns: 1fr;
  }
}


/* ==========================================================================
   BROBEX TOOL PAGES — responsive, Pi7-inspired utility workspace system
   Original BROBEX styling; shared across every individual tool route.
   ========================================================================== */

.tool-page-shell {
  width: min(1240px, calc(100% - 48px));
  padding-top: 8px;
  padding-bottom: 72px;
}

.tool-breadcrumb {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 9px;
  min-height: 42px;
  margin: 4px 0 15px;
  color: var(--muted);
  font-size: 12px;
}

.tool-breadcrumb a {
  color: var(--muted);
  transition: color .18s ease;
}

.tool-breadcrumb a:hover,
.tool-related-heading>a:hover {
  color: var(--accent);
}

.tool-breadcrumb [aria-current="page"] {
  color: var(--ink);
  font-weight: 650;
}

.brobex-studio {
  position: relative;
  isolation: isolate;
  width: 100%;
  margin: 0 auto;
  overflow: visible;
  border: 1px solid var(--line);
  border-radius: 20px;
  background: var(--surface);
  color: var(--ink);
  box-shadow: var(--shadow);
}

.brobex-studio-inner {
  width: 100%;
  max-width: 1160px;
  margin: 0 auto;
  padding: clamp(22px, 4vw, 48px);
}

.brobex-studio-topline {
  display: flex;
  align-items: center;
  gap: 15px;
  min-height: 44px;
  padding-bottom: 20px;
  border-bottom: 1px solid var(--line);
}

.brobex-studio-brand {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  min-width: 0;
  color: var(--ink);
  text-decoration: none;
}

.brobex-studio-brand-mark {
  display: grid;
  place-items: center;
  width: 34px;
  height: 34px;
  flex: 0 0 34px;
  border-radius: 9px;
  background: var(--accent);
  color: #fff;
  font-size: 17px;
  font-weight: 850;
  letter-spacing: -.06em;
}

.brobex-studio-brand-name {
  font-size: 14px;
  font-weight: 850;
  letter-spacing: -.035em;
}

.brobex-studio-brand-name span {
  color: var(--accent);
}

.brobex-studio-product-label {
  padding-left: 15px;
  border-left: 1px solid var(--line);
  color: var(--muted);
  font-size: 9px;
  font-weight: 800;
  letter-spacing: .16em;
}

.brobex-studio-privacy-label {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  margin-left: auto;
  color: var(--muted);
  font-size: 9px;
  font-weight: 750;
  letter-spacing: .1em;
}

.brobex-studio-privacy-label i,
.privacy-line-mark {
  width: 7px;
  height: 7px;
  flex: 0 0 7px;
  border-radius: 50%;
  background: #24a36b;
  box-shadow: 0 0 0 3px rgba(36, 163, 107, .12);
}

.brobex-studio-heading {
  max-width: 820px;
  margin: 0 auto;
  padding: clamp(35px, 5vw, 58px) 0 clamp(28px, 4vw, 42px);
  text-align: center;
}

.brobex-studio-category {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  padding: 7px 11px;
  border: 1px solid color-mix(in srgb, var(--accent) 22%, var(--line));
  border-radius: 7px;
  background: var(--accent-soft);
  color: var(--accent);
  font-size: 9px;
  font-weight: 850;
  letter-spacing: .13em;
}

.brobex-studio-category-divider {
  opacity: .45;
}

.brobex-studio-heading h1 {
  margin: 17px 0 10px;
  color: var(--ink);
  background: none;
  font-size: clamp(32px, 5vw, 52px);
  font-weight: 820;
  letter-spacing: -.06em;
  line-height: 1.08;
  -webkit-text-fill-color: currentColor;
}

.brobex-studio-heading h1 span {
  color: var(--accent);
