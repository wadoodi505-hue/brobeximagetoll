  padding: 19px 10px;
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
}

.brobex-studio-step-group {
  display: flex;
  align-items: center;
  gap: clamp(12px, 3vw, 28px);
}

.brobex-studio-step {
  display: flex;
  align-items: center;
  gap: 9px;
}

.brobex-studio-steps span {
  color: var(--accent);
  font-size: 11px;
  font-weight: 850;
}

.brobex-studio-steps p {
  margin: 0;
  color: var(--muted);
  font-size: 9px;
  font-weight: 800;
  letter-spacing: .13em;
}

.brobex-studio-steps i {
  width: clamp(18px, 3vw, 38px);
  height: 1px;
  background: var(--line);
