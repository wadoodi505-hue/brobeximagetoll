}

.popular-tool-content {
  display: grid;
  gap: 5px;
  min-width: 0;
}

.popular-tool-content strong {
  font-size: 13px;
  line-height: 1.35;
}

.popular-tool-content small {
  color: var(--muted);
  font-size: 11px;
  line-height: 1.5;
}

.popular-tool-arrow {
  flex: 0 0 auto;
  margin: 2px 0 0 auto;
  color: var(--muted);
