@tailwind base;
@tailwind components;
@tailwind utilities;

.crop-preview-stage {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
  min-height: 220px;
  overflow: hidden;
  border: 1px solid var(--line);
  border-radius: 12px;
  background: var(--bg);
}

.crop-preview-stage img {
  display: block;
  max-width: 100%;
  max-height: 480px;
  width: auto;
  height: auto;
  object-fit: contain;
}

.crop-preview-toggle {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 12px;
  font-size: 14px;
  cursor: pointer;
}

.crop-controls-heading {
  display: flex;
  flex-direction: column;
  gap: 4px;
  grid-column: 1 / -1;
}

.crop-controls-heading span {
  color: var(--muted, #888);
  font-size: 13px;
}

.crop-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12px;
  grid-column: 1 / -1;
}

:root {
  color-scheme: light;
  --bg: #F7F7F5;
  --surface: #fff;
  --ink: #171717;
  --muted: #737373;
  --line: #E5E5E5;
  --soft: #F0F0EE;
  --dark: #111;
  --shadow: 0 8px 30px rgba(0, 0, 0, .04)
}

:root[data-theme="dark"] {
  color-scheme: dark;
  --bg: #111;
  --surface: #191919;
  --ink: #f5f5f5;
  --muted: #a3a3a3;
  --line: #303030;
  --soft: #242424;
  --dark: #f5f5f5;
  --shadow: 0 8px 30px rgba(0, 0, 0, .2)
}

* {
  box-sizing: border-box
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 90px
}

body {
  margin: 0;
  background: var(--bg);
  color: var(--ink);
  font-family: Arial, Helvetica, sans-serif;
  font-size: 15px;
  line-height: 1.55;
  transition: background .2s, color .2s
}

a {
  color: inherit;
  text-decoration: none
}

button,
input,
select,
textarea {
  font: inherit
}

button,
a,
input,
select {
  outline-offset: 3px
}

button:focus-visible,
a:focus-visible,
input:focus-visible,
select:focus-visible {
  outline: 2px solid var(--ink)
}

button {
  cursor: pointer
}

button:disabled {
  opacity: .55;
  cursor: not-allowed
}

.site-header {
  position: sticky;
  top: 0;
  z-index: 40;
  width: 100%;
  background: color-mix(in srgb, var(--bg) 88%, transparent);
  backdrop-filter: blur(14px);
  border-bottom: 1px solid var(--line)
}

.nav-inner {
  max-width: 1240px;
  height: 72px;
  margin: auto;
  padding: 0 28px;
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: 24px
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-size: 15px;
  font-weight: 800;
  letter-spacing: .12em;
  white-space: nowrap;
  width: max-content
}

.brand-mark {
  width: 32px;
  height: 32px;
  border-radius: 9px;
  background: var(--ink);
  color: var(--bg);
  display: grid;
  place-items: center;
  font-size: 19px;
  letter-spacing: -.05em
}

.brand-light {
  font-weight: 500;
  color: var(--muted);
  margin-left: 5px;
  font-size: 11px
}

.desktop-nav {
  display: flex;
  gap: 7px;
  align-items: center
}

.desktop-nav a {
  padding: 9px 13px;
  color: var(--muted);
  border-radius: 8px;
  font-size: 13px
}

.desktop-nav a:hover,
.desktop-nav a:focus-visible {
  background: var(--soft);
  color: var(--ink)
}

.nav-actions {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 14px
}

.portfolio-link {
  display: flex;
  align-items: center;
  gap: 5px;
  font-size: 13px;
  font-weight: 600
}

.icon-button,
.mobile-menu-button {
  display: grid;
  place-items: center;
  width: 38px;
  height: 38px;
  border: 1px solid var(--line);
  background: var(--surface);
  color: var(--ink);
  border-radius: 10px
}

.mobile-menu-button {
  display: none
}

.mobile-nav {
  display: none
}

.container {
  width: min(1160px, calc(100% - 48px));
  margin-inline: auto
}

.hero {
  padding: 86px 0 60px;
  text-align: center;
  max-width: 900px;
  margin: auto
}

.eyebrow {
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: .15em;
  color: var(--muted);
  font-weight: 700
}

.hero h1 {
  font-size: clamp(44px, 7vw, 76px);
  line-height: 1.04;
  letter-spacing: -.065em;
  margin: 17px 0 14px;
  font-weight: 750
}

.hero-subtitle {
  font-size: 16px;
  font-weight: 600;
  margin: 0 0 10px
}

.hero-description {
  max-width: 650px;
  margin: 0 auto;
  color: var(--muted);
  font-size: 16px
}

.hero-search {
  max-width: 690px;
  margin: 34px auto 18px;
  text-align: left
}

.search-box {
  display: flex;
  align-items: center;
  gap: 12px;
  border: 1px solid var(--line);
  background: var(--surface);
  padding: 0 15px;
  height: 58px;
  border-radius: 14px;
  box-shadow: var(--shadow);
  color: var(--muted)
}

.search-box input {
  flex: 1;
  min-width: 0;
  border: 0;
  outline: 0;
  background: transparent;
  color: var(--ink);
  height: 100%
}

.search-box kbd {
  border: 1px solid var(--line);
  border-radius: 5px;
  padding: 1px 7px;
  font-size: 11px;
  color: var(--muted)
}

.search-box button {
  display: grid;
  place-items: center;
  border: 0;
  background: transparent;
  color: var(--muted)
}

.feature-pills {
  display: flex;
  justify-content: center;
  gap: 10px;
  flex-wrap: wrap;
  margin-top: 22px
}

.feature-pills span,
.privacy-chip {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  border: 1px solid var(--line);
  padding: 7px 10px;
  border-radius: 999px;
  color: var(--muted);
  font-size: 12px
}

.section {
  padding: 36px 0 74px
}

.section-heading {
  display: flex;
  justify-content: space-between;
  align-items: end;
  gap: 20px;
  margin-bottom: 24px
}

.section-heading h2,
.page-title h1 {
  font-size: clamp(30px, 4vw, 42px);
  line-height: 1.12;
  letter-spacing: -.045em;
  margin: 7px 0 9px
}

.section-heading p,
.page-title p {
  color: var(--muted);
  margin: 0;
  max-width: 660px
}

.text-link {
  font-size: 13px;
  font-weight: 700;
  text-decoration: underline;
  text-underline-offset: 4px
}

.category-strip {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 12px;
  margin: 25px 0 55px
}

.category-tile {
  padding: 20px;
  border: 1px solid var(--line);
  border-radius: 14px;
  background: var(--surface);
  transition: transform .16s, border-color .16s
}

.category-tile:hover {
  transform: translateY(-2px);
  border-color: var(--muted)
}

.category-tile strong {
  display: block;
  margin: 13px 0 4px
}

.category-tile p {
  font-size: 12px;
  color: var(--muted);
  margin: 0
}

.tile-icon,
.tool-icon {
  display: grid;
  place-items: center;
  width: 38px;
  height: 38px;
  border-radius: 10px;
  background: var(--soft);
  color: var(--ink)
}

.search-section {
  width: 100%
}

.search-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 14px 0 18px;
  font-size: 12px;
  color: var(--muted)
}

.filter-label {
  display: flex;
  align-items: center;
  gap: 6px
}

.filter-label select {
  background: var(--surface);
  border: 1px solid var(--line);
  color: var(--ink);
  border-radius: 8px;
  padding: 6px
}

.tool-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px
}

.tool-card {
  position: relative;
  display: flex;
  gap: 13px;
  align-items: flex-start;
  padding: 17px;
  border: 1px solid var(--line);
  background: var(--surface);
  border-radius: 13px;
  min-height: 145px;
  transition: border-color .16s, transform .16s, background .16s
}

.tool-card:hover {
  border-color: #aaa;
  transform: translateY(-2px)
}

.tool-icon {
  width: 38px;
  height: 38px;
  flex: 0 0 auto
}

.tool-card-copy {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6px;
  padding-right: 8px
}

.tool-name {
  font-weight: 700;
  font-size: 14px;
  line-height: 1.35
}

.tool-description {
  font-size: 12px;
  color: var(--muted);
  line-height: 1.5
}

.status {
  font-size: 10px;
  width: max-content;
  border-radius: 4px;
  padding: 3px 6px;
  margin-top: 3px;
  font-weight: 700
}

.status.browser {
  background: #000000;
  color: #31543b
}

.status.integration {
  background: var(--soft);
  color: var(--muted)
}

.card-arrow {
  position: absolute;
  right: 14px;
  top: 15px;
  color: var(--muted)
}

.empty-state {
  padding: 60px 20px;
  text-align: center;
  border: 1px dashed var(--line);
  border-radius: 16px;
  color: var(--muted)
}

.empty-state h3 {
  color: var(--ink);
  margin-bottom: 4px
}

.button {
  min-height: 42px;
  border-radius: 9px;
  display: inline-flex;
  justify-content: center;
  align-items: center;
  gap: 8px;
  padding: 10px 15px;
  font-weight: 700;
  font-size: 13px;
  border: 1px solid transparent
}

.button-dark {
  background: var(--ink);
  color: var(--bg)
}

.button-dark:hover {
  opacity: .85
}

.button-light {
  background: var(--surface);
  color: var(--ink);
  border-color: var(--line)
}

.page-title {
  padding: 64px 0 30px
}

.breadcrumb {
  font-size: 12px;
  color: var(--muted);
  margin-bottom: 20px
}

.breadcrumb a {
  text-decoration: underline;
  text-underline-offset: 3px
}

.page-content {
  max-width: 850px;
  padding-bottom: 80px
}

.page-content h2 {
  font-size: 23px;
  letter-spacing: -.03em;
  margin-top: 30px
}

.page-content p,
.page-content li {
  color: var(--muted)
}

.tool-detail-title {
  display: flex;
  gap: 15px;
  align-items: flex-start
}

.tool-detail-title .tool-icon {
  width: 48px;
  height: 48px
}

.tool-detail-title h1 {
  margin: 0;
  font-size: clamp(30px, 4vw, 44px);
  letter-spacing: -.05em
}

.tool-detail-title p {
  margin: 8px 0;
  color: var(--muted)
}

.workspace {
  margin: 28px 0 75px;
  border: 1px solid var(--line);
  border-radius: 18px;
  background: var(--surface);
  padding: 24px
}

.workspace-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 15px;
  margin-bottom: 22px
}

.workspace-top h2 {
  font-size: 22px;
  letter-spacing: -.03em;
  margin: 5px 0
}

.workspace-top p {
  font-size: 13px;
  color: var(--muted);
  margin: 0
}

.dropzone {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 9px;
  padding: 30px 18px;
  min-height: 180px;
  border: 1px dashed #b8b8b5;
  border-radius: 14px;
  background: var(--bg);
  text-align: center;
  cursor: pointer;
  color: var(--muted)
}

.dropzone input {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  cursor: pointer
}

.dropzone strong {
  color: var(--ink);
  font-size: 14px
}

.dropzone span,
.dropzone small {
  font-size: 12px
}

.dropzone.has-file {
  min-height: 130px
}

.file-facts {
  display: flex;
  gap: 18px;
  flex-wrap: wrap;
  padding: 14px 0;
  font-size: 12px;
  color: var(--muted)
}

.file-facts b {
  color: var(--ink);
  font-weight: 600
}

.workspace-columns {
  display: grid;
  grid-template-columns: minmax(0, 1.2fr) minmax(280px, .8fr);
  gap: 20px;
  margin-top: 20px
}

.preview-panel,
.settings-panel {
  border: 1px solid var(--line);
  border-radius: 12px;
  padding: 14px;
  min-width: 0
}

.panel-heading {
  font-size: 12px;
  font-weight: 700;
  margin: 2px 0 12px
}

.preview-canvas {
  display: grid;
  place-items: center;
  min-height: 170px;
  max-height: 420px;
  overflow: hidden;
  background: repeating-conic-gradient(var(--soft) 0% 25%, var(--surface) 0% 50%) 50% / 18px 18px;
  border-radius: 8px;
  margin-bottom: 18px
}

.preview-canvas img {
  display: block;
  max-width: 100%;
  max-height: 400px;
  object-fit: contain
}

.settings-panel h3 {
  font-size: 16px;
  margin: 2px 0 16px
}

.settings-panel>label,
.settings-grid label {
  display: flex;
  flex-direction: column;
  gap: 7px;
  font-size: 12px;
  font-weight: 600;
  margin: 13px 0
}

.settings-panel input:not([type=checkbox]):not([type=range]):not([type=color]),
.settings-panel select {
  width: 100%;
  min-height: 38px;
  border: 1px solid var(--line);
  border-radius: 8px;
  padding: 8px;
  background: var(--bg);
  color: var(--ink)
}

.settings-panel input[type=range] {
  width: 100%;
  accent-color: var(--ink)
}

.settings-panel input[type=color] {
  width: 100%;
  height: 38px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: var(--surface)
}

.check-setting {
  display: flex !important;
  flex-direction: row !important;
  align-items: center;
  gap: 9px !important
}

.settings-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px
}

.settings-grid label {
  min-width: 0
}

.workspace-actions {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  margin-top: 20px
}

.download-button {
  margin-top: 10px;
  width: 100%
}

.notice {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  font-size: 12px;
  padding: 11px;
  border-radius: 8px;
  margin-top: 14px
}

.notice.success {
  background: #000000;
  color: #31543b
}

.notice.error {
  background: #f8e9e7;
  color: #8d3028
}

.hint {
  font-size: 12px;
  color: var(--muted);
  line-height: 1.6
}

.metadata-card {
  padding: 13px;
  background: var(--bg);
  border-radius: 9px;
  font-size: 12px;
  margin-top: 14px
}

.metadata-card h4 {
  margin: 0 0 8px
}

.metadata-card p {
  margin: 4px 0;
  color: var(--muted)
}

.integration-notice {
  display: flex;
  gap: 15px;
  border: 1px solid var(--line);
  border-radius: 13px;
  padding: 20px;
  margin-top: 20px;
  background: var(--bg)
}

.integration-icon {
  display: grid;
  place-items: center;
  flex: 0 0 40px;
  height: 40px;
  border-radius: 10px;
  background: var(--soft);
  font-size: 20px
}

.integration-notice h3 {
  margin: 0 0 7px;
  font-size: 16px
}

.integration-notice p {
  margin: 0 0 8px;
  color: var(--muted);
  font-size: 13px
}

.integration-notice code {
  overflow-wrap: anywhere
}

.privacy-line {
  display: flex;
  align-items: center;
  gap: 7px;
  color: var(--muted);
  font-size: 12px;
  margin-top: 20px
}

.footer {
  border-top: 1px solid var(--line);
  padding: 45px 24px 20px;
  background: var(--surface)
}

.footer-main {
  max-width: 1160px;
  margin: auto;
  display: grid;
  grid-template-columns: 2fr 1fr 1fr;
  gap: 40px;
  padding-bottom: 35px
}

.footer-brand p {
  max-width: 270px;
  color: var(--muted);
  font-size: 13px
}

.footer-brand>a:last-child {
  font-size: 12px;
  text-decoration: underline;
  text-underline-offset: 4px
}

.footer-links {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 10px;
  font-size: 13px
}

.footer-links a {
  color: var(--muted)
}

.footer-links a:hover {
  color: var(--ink)
}

.footer-bottom {
  max-width: 1160px;
  margin: auto;
  padding-top: 17px;
  border-top: 1px solid var(--line);
  display: flex;
  justify-content: space-between;
  gap: 20px;
  color: var(--muted);
  font-size: 11px
}

.not-found {
  padding: 100px 0;
  text-align: center
}

.not-found h1 {
  font-size: 42px;
  letter-spacing: -.05em
}

.not-found p {
  color: var(--muted)
}

.divider {
  height: 1px;
  background: var(--line);
  margin: 35px 0
}

@media(max-width:900px) {
  .nav-inner {
    grid-template-columns: 1fr auto 1fr;
    padding: 0 20px;
    gap: 10px
  }

  .desktop-nav {
    gap: 0
  }

  .desktop-nav a {
    padding: 9px 8px
  }

  .portfolio-link {
    font-size: 0
  }

  .portfolio-link svg {
    width: 18px;
    height: 18px
  }

  .tool-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr))
  }

  .category-strip {
    grid-template-columns: repeat(3, minmax(0, 1fr))
  }

  .workspace-columns {
    grid-template-columns: 1fr
  }

  .preview-panel {
    order: 0
  }

  .settings-panel {
    order: 1
  }
}

@media(max-width:640px) {
  .nav-inner {
    height: 64px;
    grid-template-columns: 1fr auto 1fr;
    gap: 0;
    padding: 0 16px
  }

  .brand {
    font-size: 13px;
    gap: 7px
  }

  .brand-mark {
    width: 29px;
    height: 29px
  }

  .brand-light {
    font-size: 9px
  }

  .desktop-nav {
    display: none
  }

  .mobile-menu-button {
    display: grid;
    grid-column: 2;
    grid-row: 1;
    width: 38px;
    height: 38px
  }

  .nav-actions {
    grid-column: 3;
    grid-row: 1;
    gap: 0
  }

  .portfolio-link {
    display: none
  }

  .mobile-nav {
    display: flex;
    position: absolute;
    top: calc(100% + 1px);
    left: 0;
    right: 0;
    flex-direction: column;
    gap: 0;
    padding: 8px 16px 16px;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
    box-shadow: var(--shadow);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: opacity .16s, transform .16s, visibility .16s
  }

  .mobile-nav.is-open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0)
  }

  .mobile-nav a {
    display: flex;
    justify-content: space-between;
    padding: 14px 8px;
    border-bottom: 1px solid var(--line);
    font-weight: 600
  }

  .mobile-nav a:last-child {
    border-bottom: 0
  }

  .container {
    width: calc(100% - 32px)
  }

  .hero {
    padding: 60px 0 35px
  }

  .hero h1 {
    font-size: clamp(42px, 13vw, 62px)
  }

  .hero-description {
    font-size: 14px
  }

  .hero-search {
    margin-top: 25px
  }

  .search-box {
    height: 54px
  }

  .search-box kbd {
    display: none
  }

  .feature-pills {
    gap: 7px
  }

  .feature-pills span {
    font-size: 10px
  }

  .section {
    padding: 25px 0 55px
  }

  .section-heading {
    align-items: flex-start;
    flex-direction: column
  }

  .section-heading h2 {
    font-size: 31px
  }

  .category-strip {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
    margin-bottom: 38px
  }

  .category-tile {
    padding: 14px
  }

  .tool-grid {
    grid-template-columns: 1fr;
    gap: 9px
  }

  .tool-card {
    min-height: 0;
    padding: 14px
  }

  .tool-description {
    font-size: 12px
  }

  .page-title {
    padding: 45px 0 20px
  }

  .page-title h1 {
    font-size: 34px
  }

  .workspace {
    padding: 14px;
    margin: 20px 0 55px
  }

  .workspace-top {
    flex-direction: column
  }

  .privacy-chip {
    font-size: 10px
