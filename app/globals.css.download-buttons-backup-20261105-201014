   Applies to existing workspaces without replacing functionality.
   ========================================================== */

.workspace {
  position: relative;
  isolation: isolate;
  overflow: hidden;
  border: 1px solid color-mix(in srgb, var(--line) 75%, #000000 25%);
  border-radius: 24px;
  background:
    radial-gradient(ellipse at 0% 0%,
      rgba(199, 123, 83, 0.075),
      transparent 42%),
    var(--surface);
  box-shadow:
    0 18px 55px rgba(0, 0, 0, 0.09),
    inset 0 1px 0 rgba(255, 255, 255, 0.035);
  transition: border-color 180ms ease, box-shadow 180ms ease;
}

.workspace:focus-within {
  border-color: color-mix(in srgb, var(--line) 55%, #000000 45%);
}

.workspace-top {
  gap: 18px;
  margin-bottom: 24px;
}

.workspace-columns {
  align-items: start;
  gap: 22px;
}

.workspace .dropzone {
  position: relative;
  display: flex;
  min-height: 190px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12px;
  padding: 28px 20px;
  border: 1.5px dashed color-mix(in srgb, var(--line) 55%, #000000 45%);
  border-radius: 19px;
  background:
    linear-gradient(145deg,
      rgba(199, 123, 83, 0.075),
      transparent 65%),
    color-mix(in srgb, var(--surface) 94%, #000000 6%);
  text-align: center;
  cursor: pointer;
  transition:
    border-color 180ms ease,
    background 180ms ease,
    transform 180ms ease,
    box-shadow 180ms ease;
}

.workspace .dropzone:hover {
  border-color: #000000;
  background-color: color-mix(in srgb, var(--surface) 88%, #000000 12%);
  box-shadow: 0 10px 30px rgba(199, 123, 83, 0.09);
}

.workspace .dropzone:focus-within {
  outline: 2px solid #000000;
  outline-offset: 4px;
}

.workspace .dropzone input[type="file"] {
  max-width: 100%;
  font: inherit;
  font-size: 13px;
  cursor: pointer;
}

.workspace input[type="file"]::file-selector-button {
  margin: 0 10px 0 0;
  padding: 10px 16px;
  border: 1px solid rgba(199, 123, 83, 0.45);
  border-radius: 10px;
  background: linear-gradient(135deg, #000000, #000000);
  color: #fff;
  font: inherit;
  font-size: 13px;
  font-weight: 700;
  cursor: pointer;
  transition: filter 180ms ease, transform 180ms ease;
}

.workspace input[type="file"]::file-selector-button:hover {
  filter: brightness(1.12);
  transform: translateY(-1px);
}

.workspace button,
.workspace .workspace-actions a,
.workspace a[role="button"] {
  min-height: 42px;
  border-radius: 11px;
  font-weight: 650;
  transition:
    transform 160ms ease,
    box-shadow 160ms ease,
    border-color 160ms ease,
    background 160ms ease,
    filter 160ms ease;
}

.workspace button:hover:not(:disabled),
.workspace .workspace-actions a:hover,
.workspace a[role="button"]:hover {
  transform: translateY(-2px);
}

.workspace button:active:not(:disabled),
.workspace .workspace-actions a:active {
  transform: translateY(0);
}

.workspace button:focus-visible,
.workspace a:focus-visible,
.workspace input:focus-visible,
.workspace select:focus-visible,
.workspace textarea:focus-visible {
  outline: 2px solid #000000;
  outline-offset: 3px;
}

.workspace button:disabled {
  cursor: not-allowed;
  opacity: 0.48;
  transform: none;
}

.workspace input:not([type="file"]):not([type="checkbox"]):not([type="radio"]),
.workspace select,
.workspace textarea {
  max-width: 100%;
  border-radius: 11px;
  transition: border-color 160ms ease, box-shadow 160ms ease;
}

.workspace input:not([type="file"]):focus,
.workspace select:focus,
