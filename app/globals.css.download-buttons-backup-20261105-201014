.crop-editor-viewport {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
  min-height: 240px;
  padding: 12px;
  overflow: hidden;
  border: 1px solid var(--line);
  border-radius: 12px;
  background: var(--bg);
}

.crop-editor-stage {
  position: relative;
  display: inline-block;
  max-width: 100%;
  line-height: 0;
  touch-action: none;
  user-select: none;
}

.crop-editor-stage>img {
  display: block;
  width: auto;
  height: auto;
  max-width: 100%;
  max-height: 480px;
  object-fit: contain;
  pointer-events: none;
}

.crop-selection {
  position: absolute;
  box-sizing: border-box;
  border: 2px solid #00e887;
  box-shadow: 0 0 0 9999px rgb(0 0 0 / 58%);
  cursor: move;
  touch-action: none;
}

.crop-handle {
  position: absolute;
  display: block;
  width: 12px;
  height: 12px;
  border: 2px solid #00e887;
  border-radius: 3px;
  background: #fff;
  touch-action: none;
}

.crop-handle-nw {
  top: -6px;
  left: -6px;
  cursor: nwse-resize;
}

.crop-handle-ne {
  top: -6px;
  right: -6px;
  cursor: nesw-resize;
}

.crop-handle-sw {
  bottom: -6px;
  left: -6px;
  cursor: nesw-resize;
}

.crop-handle-se {
  right: -6px;
  bottom: -6px;
  cursor: nwse-resize;
}

.crop-handle-n,
.crop-handle-s {
  left: 50%;
  transform: translateX(-50%);
  cursor: ns-resize;
}

.crop-handle-n {
  top: -6px;
}

.crop-handle-s {
  bottom: -6px;
}

.crop-handle-e,
.crop-handle-w {
  top: 50%;
  transform: translateY(-50%);
  cursor: ew-resize;
}

.crop-handle-e {
  right: -6px;
}

.crop-handle-w {
  left: -6px;
}

.crop-dimensions,
.crop-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 10px;
}

.crop-dimensions {
