.brobex-compressor {
  display: grid;
  gap: 22px;
  width: 100%;
  min-width: 0;
  padding: clamp(16px, 3vw, 30px);
  border: 1px solid var(--border, rgba(255, 255, 255, .12));
  border-radius: 22px;
  background: var(--card, rgba(20, 20, 20, .7));
  box-shadow: 0 18px 55px rgba(0, 0, 0, .12);
}

.brobex-compressor-heading,
.brobex-compressor-image-heading,
.brobex-compressor-image-footer,
.brobex-compressor-controls label>span,
.brobex-compressor-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.brobex-compressor-heading h2 {
  margin: 7px 0;
  font-size: clamp(22px, 3vw, 32px);
  letter-spacing: -.045em;
}

.brobex-compressor-heading p {
  margin: 0;
  color: var(--muted, #999);
  line-height: 1.6;
}

.brobex-compressor-status {
  display: inline-flex;
  flex-shrink: 0;
  align-items: center;
  gap: 8px;
  padding: 8px 12px;
  border: 1px solid var(--border, rgba(255, 255, 255, .12));
  border-radius: 999px;
  font-size: 12px;
}

.brobex-compressor-status>span {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #a1a1aa;
}

.brobex-compressor-status.is-processing>span {
  background: #eab308;
  animation: brobex-compressor-pulse 1s infinite alternate;
}

.brobex-compressor-status.is-complete>span {
  background: #22c55e;
}

@keyframes brobex-compressor-pulse {
  to {
    opacity: .35;
    transform: scale(.75);
  }
}

.brobex-compressor-controls {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
  padding: 18px;
  border: 1px solid var(--border, rgba(255, 255, 255, .12));
  border-radius: 16px;
}

.brobex-compressor-controls label {
  display: grid;
  gap: 11px;
  min-width: 0;
