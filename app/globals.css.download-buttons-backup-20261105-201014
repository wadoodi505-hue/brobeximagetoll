.tool-info-card h2 {
  margin: 0 0 12px;
  font-size: 17px;
}

.tool-info-card ol {
  display: grid;
  gap: 9px;
  margin: 0;
  padding-left: 20px;
  color: var(--muted);
  font-size: 12px;
  line-height: 1.7;
}

.tool-info-card li {
  padding-left: 3px;
}

.tool-info-card p {
  margin: 0;
  font-size: 12px;
  line-height: 1.8;
}

.tool-info-card strong {
  color: var(--ink);
  font-weight: 700;
}

.tool-related-section {
  margin-top: 38px;
  padding-top: 28px;
  border-top: 1px solid var(--line);
}

.tool-related-heading {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 16px;
}

.tool-related-heading .tool-info-eyebrow {
  margin-bottom: 6px;
}

.tool-related-heading h2 {
  margin: 0;
}

.tool-related-heading>a {
  flex: 0 0 auto;
  color: var(--muted);
  font-size: 11px;
  font-weight: 700;
}

.brobex-studio-steps {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: clamp(12px, 3vw, 28px);
